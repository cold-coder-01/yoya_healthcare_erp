<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hospital_pharmacy_medicine_fiscal_inherit" model="ir.ui.view">
        <field name="name">hospital.pharmacy.medicine.fiscal.inherit</field>
        <field name="model">hospital.pharmacy.medicine</field>
        <field name="inherit_id" ref="hospital_pharmacy.view_hospital_pharmacy_medicine_form"/>
        <field name="arch" type="xml">
            <field name="category" position="after">
                <field name="sale_price"/>
            </field>
        </field>
    </record>

    <record id="view_hospital_pharmacy_medicine_list_fiscal_inherit" model="ir.ui.view">
        <field name="name">hospital.pharmacy.medicine.list.fiscal.inherit</field>
        <field name="model">hospital.pharmacy.medicine</field>
        <field name="inherit_id" ref="hospital_pharmacy.view_hospital_pharmacy_medicine_list"/>
        <field name="arch" type="xml">
            <list position="inside">
                <field name="sale_price" optional="show"/>
            </list>
        </field>
    </record>

</odoo>
