<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hospital_hr_credential_list" model="ir.ui.view">
        <field name="name">hospital.hr.credential.list</field>
        <field name="model">hospital.hr.credential</field>
        <field name="arch" type="xml">
            <list string="Credentials"
                  decoration-danger="status in ('expired', 'suspended')"
                  decoration-warning="status == 'expiring_soon'"
                  decoration-muted="status == 'pending_verification'">
                <field name="employee_id"/>
                <field name="credential_type"/>
                <field name="credential_name"/>
                <field name="license_number" optional="show"/>
                <field name="issuing_authority" optional="show"/>
                <field name="issue_date" optional="hide"/>
                <field name="expiry_date"/>
                <field name="days_to_expiry" optional="show"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'valid'"
                       decoration-warning="status == 'expiring_soon'"
                       decoration-danger="status in ('expired', 'suspended')"
                       decoration-info="status in ('pending_verification', 'no_expiry')"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_hr_credential_form" model="ir.ui.view">
        <field name="name">hospital.hr.credential.form</field>
        <field name="model">hospital.hr.credential</field>
        <field name="arch" type="xml">
            <form string="Credential">
                <header>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1" placeholder="Credential"/></h1>
                    </div>
                    <group>
                        <group string="Employee / Role" name="employee_role">
                            <field name="employee_id"/>
                            <field name="hospital_role_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="License Details" name="license_details">
                            <field name="credential_type"/>
                            <field name="credential_name"/>
                            <field name="license_number"/>
                            <field name="issuing_authority"/>
                        </group>
                        <group string="Validity" name="validity">
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="days_to_expiry" invisible="not expiry_date"/>
                            <field name="manual_status"/>
                        </group>
                        <group string="Documents" name="documents">
                            <field name="attachment_ids" nolabel="1" widget="many2many_binary"/>
                        </group>
                    </group>
                    <group string="Notes" name="notes">
                        <field name="notes" nolabel="1"
                               placeholder="Renewal requirements, verification details, ..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hospital_hr_credential_search" model="ir.ui.view">
        <field name="name">hospital.hr.credential.search</field>
        <field name="model">hospital.hr.credential</field>
        <field name="arch" type="xml">
            <search string="Credentials">
                <field name="employee_id"/>
                <field name="credential_name"/>
                <field name="license_number"/>
                <field name="issuing_authority"/>
                <filter name="filter_valid" string="Valid"
                        domain="[('status', '=', 'valid')]"/>
                <filter name="filter_expiring_soon" string="Expiring Soon"
                        domain="[('status', '=', 'expiring_soon')]"/>
                <filter name="filter_expired" string="Expired"
                        domain="[('status', '=', 'expired')]"/>
                <filter name="filter_suspended" string="Suspended"
                        domain="[('status', '=', 'suspended')]"/>
                <filter name="filter_pending_verification" string="Pending Verification"
                        domain="[('status', '=', 'pending_verification')]"/>
                <filter name="filter_no_expiry" string="No Expiry"
                        domain="[('status', '=', 'no_expiry')]"/>
                <separator/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_employee" string="Employee"
                            domain="[]" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_hospital_role" string="Hospital Role"
                            domain="[]" context="{'group_by': 'hospital_role_id'}"/>
                    <filter name="group_credential_type" string="Credential Type"
                            domain="[]" context="{'group_by': 'credential_type'}"/>
                    <filter name="group_status" string="Status"
                            domain="[]" context="{'group_by': 'status'}"/>
                    <filter name="group_issuing_authority" string="Issuing Authority"
                            domain="[]" context="{'group_by': 'issuing_authority'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
