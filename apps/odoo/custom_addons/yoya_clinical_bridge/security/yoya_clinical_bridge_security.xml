<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Record rules for hospital.patient.evaluation.

            hospital_management ships ACLs but no record rules whatsoever, so
            before this module every role holding a read ACL saw every
            evaluation in the hospital. These rules give each of those roles a
            deliberate scope.

            HOW ODOO COMBINES THESE
            =======================
            For one operation, Odoo collects the rules whose matching perm_*
            flag is set and whose groups intersect the user's groups, then ORs
            their domains together. Global rules (no groups) would be ANDed on
            top; this module defines none.

            The OR is the important part: rules attached to groups can only
            WIDEN access for a user who holds several of those groups. A group
            rule can therefore never deny anything to a user who also holds a
            more permissive group. Genuine denial lives in the ACL layer, or in
            a global rule.

            group_hospital_manager implies receptionist + doctor + nurse, and
            group_hospital_system_administrator implies manager + DPO, so both
            match the unrestricted rule below and keep full visibility.
        -->

        <!-- ============================================================
             Clinical roles
             ============================================================ -->

        <record id="rule_patient_evaluation_nurse" model="ir.rule">
            <field name="name">Patient Evaluation: assigned to me, or unassigned in my department (nurse)</field>
            <field name="model_id" ref="hospital_management.model_hospital_patient_evaluation"/>
            <field name="groups" eval="[(4, ref('hospital_management.group_hospital_nurse'))]"/>
            <!--
                assigned_nurse_id = me
                OR (unassigned AND has an appointment AND that appointment's
                    department is one of mine)

                An evaluation with no appointment carries no department, so it
                is reachable only through explicit assignment.
            -->
            <field name="domain_force">
                ['|',
                    ('assigned_nurse_id', '=', user.id),
                    '&amp;', '&amp;',
                        ('assigned_nurse_id', '=', False),
                        ('appointment_id', '!=', False),
                        ('appointment_id.department_id', 'in', user.yoya_permitted_department_ids.ids)
                ]
            </field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_patient_evaluation_doctor" model="ir.rule">
            <field name="name">Patient Evaluation: my patients (doctor)</field>
            <field name="model_id" ref="hospital_management.model_hospital_patient_evaluation"/>
            <field name="groups" eval="[(4, ref('hospital_management.group_hospital_doctor'))]"/>
            <field name="domain_force">
                ['|',
                    ('physician_id.user_id', '=', user.id),
                    ('appointment_id.doctor_id.user_id', '=', user.id)
                ]
            </field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_patient_evaluation_manager" model="ir.rule">
            <field name="name">Patient Evaluation: all (manager / system administrator)</field>
            <field name="model_id" ref="hospital_management.model_hospital_patient_evaluation"/>
            <field name="groups" eval="[(4, ref('hospital_management.group_hospital_manager')), (4, ref('hospital_management.group_hospital_system_administrator'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ============================================================
             Administrative / oversight roles (read ACL only)
             ============================================================ -->

        <record id="rule_patient_evaluation_receptionist" model="ir.rule">
            <field name="name">Patient Evaluation: appointment-linked only (receptionist)</field>
            <field name="model_id" ref="hospital_management.model_hospital_patient_evaluation"/>
            <field name="groups" eval="[(4, ref('hospital_management.group_hospital_receptionist'))]"/>
            <!--
                Front desk schedules appointments, so evaluations that hang off
                an appointment are in scope. An appointment-less evaluation is
                a purely clinical artefact and is not.

                Read-only: the receptionist ACL is 1,0,0,0 and this module adds
                no write/create/unlink permission.
            -->
            <field name="domain_force">[('appointment_id', '!=', False)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_patient_evaluation_dpo" model="ir.rule">
            <field name="name">Patient Evaluation: full read for oversight (data protection officer)</field>
            <field name="model_id" ref="hospital_management.model_hospital_patient_evaluation"/>
            <field name="groups" eval="[(4, ref('hospital_management.group_hospital_data_protection_officer'))]"/>
            <!--
                Deliberately unrestricted, not unrestricted by omission. The DPO
                exists to audit clinical record handling, which requires sight
                of every record. The ACL (1,0,0,0) keeps this strictly read-only.
            -->
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ============================================================
             Roles with no clinical evaluation mandate
             ============================================================

             Pharmacist, laboratory technician and accountant hold NO ACL row
             for hospital.patient.evaluation in any installed module, so they
             already have no access at all. This rule grants nothing and
             changes nothing today.

             They are declared anyway as a standing default: should any future
             module add a read ACL for these groups, the evaluation set is
             clamped to empty rather than silently opening to the whole
             hospital. All four perm_* flags are set so the clamp covers every
             operation.

             This is safe for multi-role users. Because group rules OR, a user
             who is both pharmacist and nurse still gets the full nurse scope.
        -->

        <record id="rule_patient_evaluation_no_clinical_access" model="ir.rule">
            <field name="name">Patient Evaluation: no access (pharmacist / lab technician / accountant)</field>
            <field name="model_id" ref="hospital_management.model_hospital_patient_evaluation"/>
            <field name="groups" eval="[(4, ref('hospital_management.group_hospital_pharmacist')), (4, ref('hospital_management.group_hospital_lab_technician')), (4, ref('hospital_management.group_hospital_accountant'))]"/>
            <field name="domain_force">[(0, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ============================================================
             hospital.consultation
             ============================================================

             THE PHYSICIAN'S NOTE, and the most confidential record this
             module owns. The same OR semantics described at the top of this
             file apply, so restriction lives in the ACL rows
             (security/ir.model.access.csv) and these rules narrow WHICH rows
             each already-permitted role can reach.

             Only FOUR groups hold an ACL row at all: doctor, manager, system
             administrator and DPO. Everyone else holds none, so they have no
             access to consultation notes whatever their access to the
             appointment or the encounter.

             WHY HOSPITAL NURSE IS NOT ONE OF THEM
             =====================================
             An earlier version of this slice granted Hospital Nurse read,
             scoped by yoya_permitted_department_ids, on a continuity-of-care
             argument. That was withdrawn because the exclusion it depended on
             was accidental rather than structural.

             group_hospital_front_desk_nurse IMPLIES group_hospital_nurse
             (yoya_reception_bridge/security/yoya_reception_groups.xml), and
             Odoo ORs record rules across a user's groups, so ANY grant to
             Hospital Nurse reaches the front desk. The only thing keeping the
             entrance out was that a front desk nurse happens to have no
             permitted departments today. That is a configuration accident: the
             field is also consulted by the nurse rules on
             hospital.patient.evaluation and hospital.appointment, so assigning
             a department for an unrelated workflow would have silently handed
             the entrance every physician note in that department. A deny rule
             cannot repair this either: an empty group rule ORs with the
             permissive one and loses.

             There is no ward-nurse group to grant instead. The repository
             defines thirteen groups and the only nurse-shaped ones are
             Hospital Nurse and Hospital Front Desk Nurse; hospital_nursing
             declares no res.groups of its own. So the honest options were to
             grant nothing or to invent a group, and inventing security
             architecture is not this slice's business.

             ABSENCE OF AN ACL ROW IS THE CONTROL, and it is the one control
             that cannot be widened by OR: no rule anywhere can grant a row on
             a model the group may not touch at all. When ward nursing becomes
             real, the grant should hang off a group the front desk does not
             imply, not off Hospital Nurse.
        -->

        <record id="rule_consultation_doctor" model="ir.rule">
            <field name="name">Consultation: my patients (doctor)</field>
            <field name="model_id" ref="model_hospital_consultation"/>
            <field name="groups" eval="[(4, ref('hospital_management.group_hospital_doctor'))]"/>
            <!--
                Exactly the shape of rule_encounter_doctor and
                rule_patient_evaluation_doctor, so a doctor's consultation
                scope cannot be wider than the visits and encounters it
                documents. A PURE doctor therefore never reaches a colleague's
                consultation, which is the property test_doctor_consultation_api
                pins.

                appointment_id is a STORED related column, so this branch is a
                real index lookup rather than a traversal of a computed field.
            -->
            <field name="domain_force">
                ['|',
                    ('doctor_id.user_id', '=', user.id),
                    ('appointment_id.doctor_id.user_id', '=', user.id)
                ]
            </field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_consultation_manager" model="ir.rule">
            <field name="name">Consultation: all (manager / system administrator)</field>
            <field name="model_id" ref="model_hospital_consultation"/>
            <field name="groups" eval="[(4, ref('hospital_management.group_hospital_manager')), (4, ref('hospital_management.group_hospital_system_administrator'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_consultation_dpo" model="ir.rule">
            <field name="name">Consultation: full read for oversight (data protection officer)</field>
            <field name="model_id" ref="model_hospital_consultation"/>
            <field name="groups" eval="[(4, ref('hospital_management.group_hospital_data_protection_officer'))]"/>
            <!-- Deliberately unrestricted, not unrestricted by omission: the
                 DPO audits clinical record handling. The ACL (1,0,0,0) keeps
                 this strictly read-only. -->
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_consultation_no_clinical_access" model="ir.rule">
            <field name="name">Consultation: no access (nursing / front office / finance / pharmacy / laboratory)</field>
            <field name="model_id" ref="model_hospital_consultation"/>
            <field name="groups" eval="[(4, ref('hospital_management.group_hospital_nurse')), (4, ref('hospital_management.group_hospital_receptionist')), (4, ref('hospital_management.group_hospital_pharmacist')), (4, ref('hospital_management.group_hospital_lab_technician')), (4, ref('hospital_management.group_hospital_accountant')), (4, ref('hospital_billing.group_hospital_cashier')), (4, ref('hospital_billing.group_hospital_insurance_officer'))]"/>
            <!--
                A STANDING DEFAULT, NOT TODAY'S ENFORCEMENT, and the difference
                matters: none of these groups holds an ACL row for
                hospital.consultation, so none has any access right now and this
                rule grants nothing. THE ACL IS THE CONTROL. This rule cannot be
                one, because Odoo ORs group rules and a [(0,'=',1)] domain loses
                to any permissive rule the same user picks up elsewhere.

                It is declared so that if a future module ever adds a read ACL
                for one of them (the obvious accident, since they all already
                read hospital.appointment or hospital.encounter), the
                consultation set is clamped to empty for anyone holding ONLY
                these groups, rather than silently opening the whole hospital's
                physician notes.

                Hospital Nurse is named here for exactly that reason: it is the
                group most likely to be granted a read ACL by a well-meaning
                later change. Hospital Front Desk Nurse is NOT named, and does
                not need to be: it IMPLIES Hospital Nurse, so every front desk
                nurse already matches the nurse clamp. It also could not be
                named here even if we wanted to, because it is declared in
                yoya_reception_bridge, which DEPENDS on this module and
                therefore loads after it.

                Safe for multi-role users: because group rules OR, a manager
                (who implies receptionist and nurse) still gets the unrestricted
                manager rule above.
            -->
            <field name="domain_force">[(0, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ============================================================
             hospital.patient.diagnosis
             ============================================================

             THE STATE THIS INHERITS. hospital_management ships ACL rows for
             this model and NO record rules whatsoever, so before this module
             every role holding a read ACL saw every diagnosis in the hospital,
             and Hospital Nurse held perm_create. The rules below give each
             role a deliberate scope; the ACL override underneath corrects a
             permission that was simply wrong.

             THIS NARROWS EXISTING ACCESS. A doctor previously saw the whole
             hospital's diagnoses in the Odoo backend and now sees their own.
             That is the intended correction, not a side effect.
        -->

        <record id="rule_patient_diagnosis_doctor" model="ir.rule">
            <field name="name">Patient Diagnosis: my patients (doctor)</field>
            <field name="model_id" ref="hospital_management.model_hospital_patient_diagnosis"/>
            <field name="groups" eval="[(4, ref('hospital_management.group_hospital_doctor'))]"/>
            <!--
                Three ways a diagnosis is legitimately this doctor's: they
                recorded it, it belongs to a visit assigned to them, or it
                belongs to a consultation they are conducting. The third branch
                is what makes a diagnosis reachable in the same request that
                creates it, before physician_id has been read back.

                DELIBERATELY NOT A PATIENT-WIDE READ. Showing a doctor every
                past diagnosis for any patient they are treating is a HISTORY
                feature with its own consent and confidentiality questions, and
                it is a later slice. Scoping tightly now is the conservative
                direction: widening later is a decision, narrowing later is a
                regression someone has already relied on.
            -->
            <field name="domain_force">
                ['|', '|',
                    ('physician_id.user_id', '=', user.id),
                    ('appointment_id.doctor_id.user_id', '=', user.id),
                    ('consultation_id.doctor_id.user_id', '=', user.id)
                ]
            </field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_patient_diagnosis_manager" model="ir.rule">
            <field name="name">Patient Diagnosis: all (manager / system administrator)</field>
            <field name="model_id" ref="hospital_management.model_hospital_patient_diagnosis"/>
            <field name="groups" eval="[(4, ref('hospital_management.group_hospital_manager')), (4, ref('hospital_management.group_hospital_system_administrator'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_patient_diagnosis_dpo" model="ir.rule">
            <field name="name">Patient Diagnosis: full read for oversight (data protection officer)</field>
            <field name="model_id" ref="hospital_management.model_hospital_patient_diagnosis"/>
            <field name="groups" eval="[(4, ref('hospital_management.group_hospital_data_protection_officer'))]"/>
            <!-- Same mandate, and the same read-only ACL, the DPO already has
                 on evaluations and consultations. -->
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_patient_diagnosis_no_clinical_access" model="ir.rule">
            <field name="name">Patient Diagnosis: no access (nursing / front office / finance / pharmacy / laboratory)</field>
            <field name="model_id" ref="hospital_management.model_hospital_patient_diagnosis"/>
            <field name="groups" eval="[(4, ref('hospital_management.group_hospital_nurse')), (4, ref('hospital_management.group_hospital_receptionist')), (4, ref('hospital_management.group_hospital_pharmacist')), (4, ref('hospital_management.group_hospital_lab_technician')), (4, ref('hospital_management.group_hospital_accountant')), (4, ref('hospital_billing.group_hospital_cashier')), (4, ref('hospital_billing.group_hospital_insurance_officer'))]"/>
            <!--
                UNLIKE the consultation clamp, this one is doing real work
                today: hospital_management grants Hospital Nurse and Hospital
                Receptionist a read ACL on this model, so without this rule they
                would read every diagnosis in the hospital.

                THE DOMAIN IS STRUCTURALLY EMPTY, not configuration-dependent.
                Slice 1's nurse rule kept the front desk out only because a
                front desk nurse happened to have no permitted departments,
                which any unrelated workflow change could have undone.
                [(0,'=',1)] cannot be undone by configuration.

                Front Desk Nurse is covered without being named: it IMPLIES
                Hospital Nurse. It also could not be named here, because it is
                declared in yoya_reception_bridge, which depends on this module.

                Safe for multi-role users: rules OR, so a manager (who implies
                receptionist and nurse) still gets the unrestricted manager rule
                above, and a doctor still gets the doctor rule.
            -->
            <field name="domain_force">[(0, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ============================================================
             ACL corrections on hospital_management's diagnosis rows
             ============================================================

             Referenced by their full external id so this module amends the
             existing row rather than adding a competing one, because ACLs UNION
             across rows, so a second row could only ever widen access. Same
             technique hospital_billing_accounting uses to amend groups it does
             not own.
        -->

        <record id="hospital_management.access_hospital_patient_diagnosis_nurse" model="ir.model.access">
            <!-- Hospital Nurse shipped with perm_create=1 on diagnoses. Making
                 a diagnosis is a physician's act; nursing observations belong
                 on hospital.patient.evaluation, which nurses own outright. The
                 read bit is left in place so no existing screen hard-errors,
                 and the clamp rule above reduces what it returns to nothing. -->
            <field name="perm_create" eval="False"/>
        </record>

    </data>
</odoo>
