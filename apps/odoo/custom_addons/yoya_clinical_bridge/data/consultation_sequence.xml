<?xml version="1.0" encoding="utf-8"?>
<!--
    noupdate="1" so a module upgrade never rewinds number_next. Same guard, and
    the same reason, as yoya_reception_bridge/data/reception_sequence.xml.
-->
<odoo noupdate="1">

    <record id="seq_hospital_consultation" model="ir.sequence">
        <field name="name">Consultation Sequence</field>
        <field name="code">hospital.consultation.sequence</field>
        <field name="prefix">CONS</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

</odoo>
