<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- PROCEDURE TYPE — LIST VIEW -->
    <record id="view_hospital_procedure_type_list" model="ir.ui.view">
        <field name="name">hospital.procedure.type.list</field>
        <field name="model">hospital.procedure.type</field>
        <field name="arch" type="xml">
            <list string="Procedure Types">
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="default_price"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="requires_admission"/>
                <field name="requires_doctor_approval"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- PROCEDURE TYPE — FORM VIEW -->
    <record id="view_hospital_procedure_type_form" model="ir.ui.view">
        <field name="name">hospital.procedure.type.form</field>
        <field name="model">hospital.procedure.type</field>
        <field name="arch" type="xml">
            <form string="Procedure Type">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Procedure / Service Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Catalog Details">
                            <field name="code"/>
                            <field name="category"/>
                            <field name="active"/>
                        </group>
                        <group string="Price &amp; Requirements">
                            <field name="default_price"/>
                            <field name="currency_id"/>
                            <field name="requires_admission"/>
                            <field name="requires_doctor_approval"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" placeholder="Describe the clinical service / procedure..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- PROCEDURE TYPE — SEARCH VIEW -->
    <record id="view_hospital_procedure_type_search" model="ir.ui.view">
        <field name="name">hospital.procedure.type.search</field>
        <field name="model">hospital.procedure.type</field>
        <field name="arch" type="xml">
            <search string="Procedure Types">
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <filter string="Requires Admission" name="requires_admission" domain="[('requires_admission', '=', True)]"/>
                <filter string="Requires Doctor Approval" name="requires_doctor_approval" domain="[('requires_doctor_approval', '=', True)]"/>
                <separator/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- PROCEDURE TYPE — ACTION -->
    <record id="action_hospital_procedure_type" model="ir.actions.act_window">
        <field name="name">Procedure Types</field>
        <field name="res_model">hospital.procedure.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hospital_procedure_type_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No procedure types defined yet.
            </p>
            <p>Create the clinical services and procedures your hospital offers.</p>
        </field>
    </record>

</odoo>
