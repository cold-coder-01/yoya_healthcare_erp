<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Task 31B — Demo item catalog ONLY.

        This file loads only as DEMO data (manifest "demo" key), never as normal
        production data. It creates a realistic hospital item catalog so the full
        Opening Stock -> Issue -> Consumption flow can be tested.

        It deliberately creates NO batches and NO opening quantities: stock must
        always enter the system through Opening Stock (or a future receipt) into a
        real location. Use the "Recommended Demo Opening Stock" table in README.md
        to load quantities manually.
    -->

    <!-- 1. Medicines -->
    <record id="demo_item_med_para500" model="hospital.inventory.item">
        <field name="code">MED-PARA500</field>
        <field name="name">Paracetamol 500mg Tablet</field>
        <field name="item_type">medicine</field>
        <field name="unit_of_measure">tablet</field>
        <field name="standard_cost">2.50</field>
        <field name="minimum_stock_level">500</field>
        <field name="reorder_level">1000</field>
        <field name="requires_batch_tracking" eval="True"/>
        <field name="requires_expiry_tracking" eval="True"/>
        <field name="accounting_category">medicine</field>
        <field name="cost_method">batch_actual</field>
    </record>

    <record id="demo_item_med_amox500" model="hospital.inventory.item">
        <field name="code">MED-AMOX500</field>
        <field name="name">Amoxicillin 500mg Capsule</field>
        <field name="item_type">medicine</field>
        <field name="unit_of_measure">capsule</field>
        <field name="standard_cost">6.00</field>
        <field name="minimum_stock_level">300</field>
        <field name="reorder_level">600</field>
        <field name="requires_batch_tracking" eval="True"/>
        <field name="requires_expiry_tracking" eval="True"/>
        <field name="accounting_category">medicine</field>
        <field name="cost_method">batch_actual</field>
    </record>

