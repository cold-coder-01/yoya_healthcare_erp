<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="sequence_hospital_inventory_batch" model="ir.sequence">
        <field name="name">Inventory Batch Sequence</field>
        <field name="code">hospital.inventory.batch.sequence</field>
        <field name="prefix">BATCH</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

