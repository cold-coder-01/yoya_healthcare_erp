<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hospital_inventory_category_list" model="ir.ui.view">
        <field name="name">hospital.inventory.category.list</field>
        <field name="model">hospital.inventory.category</field>
        <field name="arch" type="xml">
            <list string="Item Categories" editable="top">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_inventory_category_form" model="ir.ui.view">
        <field name="name">hospital.inventory.category.form</field>
        <field name="model">hospital.inventory.category</field>
        <field name="arch" type="xml">
            <form string="Item Category">
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Category name..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" placeholder="Optional description..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hospital_inventory_category_search" model="ir.ui.view">
        <field name="name">hospital.inventory.category.search</field>
        <field name="model">hospital.inventory.category</field>
        <field name="arch" type="xml">
            <search string="Item Categories">
                <field name="name"/>
                <field name="code"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_hospital_inventory_category" model="ir.actions.act_window">
        <field name="name">Item Categories</field>
        <field name="res_model">hospital.inventory.category</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No item categories yet.</p>
            <p>Create categories to organize inventory items (e.g. Pharmacy Medicine, Nursing Supply).</p>
        </field>
    </record>

</odoo>
