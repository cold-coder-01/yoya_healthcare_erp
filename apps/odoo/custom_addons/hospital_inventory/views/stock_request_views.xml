<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- STOCK REQUEST — LIST VIEW -->
    <record id="view_hospital_stock_request_list" model="ir.ui.view">
        <field name="name">hospital.stock.request.list</field>
        <field name="model">hospital.stock.request</field>
        <field name="arch" type="xml">
            <list string="Stock Requests"
                decoration-muted="state in ('cancelled', 'rejected')"
                decoration-info="state in ('submitted', 'approved')"
                decoration-warning="state == 'partially_issued'"
                decoration-success="state in ('issued', 'returned')">
                <field name="name"/>
                <field name="department_id"/>
                <field name="request_type"/>
                <field name="priority"/>
                <field name="requested_by"/>
                <field name="request_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- STOCK REQUEST — FORM VIEW -->
    <record id="view_hospital_stock_request_form" model="ir.ui.view">
        <field name="name">hospital.stock.request.form</field>
        <field name="model">hospital.stock.request</field>
        <field name="arch" type="xml">
            <form string="Stock Request">
                <header>
                    <button name="action_submit" string="Submit" type="object"
                        class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object"
                        class="btn-primary" invisible="state != 'submitted'"
                        groups="hospital_management.group_hospital_pharmacist,hospital_management.group_hospital_manager,hospital_management.group_hospital_system_administrator"/>
                    <button name="action_issue_stock" string="Issue Stock" type="object"
                        class="btn-primary" invisible="state not in ('approved', 'partially_issued') or request_type == 'return_to_store'"
                        groups="hospital_management.group_hospital_pharmacist,hospital_management.group_hospital_manager,hospital_management.group_hospital_system_administrator"/>
                    <button name="action_return_stock" string="Return" type="object"
                        class="btn-primary" invisible="state not in ('approved', 'issued', 'partially_issued') or request_type != 'return_to_store'"
                        groups="hospital_management.group_hospital_pharmacist,hospital_management.group_hospital_manager,hospital_management.group_hospital_system_administrator"/>
                    <button name="action_reject" string="Reject" type="object"
                        invisible="state != 'submitted'"
                        groups="hospital_management.group_hospital_pharmacist,hospital_management.group_hospital_manager,hospital_management.group_hospital_system_administrator"/>
                    <button name="action_cancel" string="Cancel" type="object"
                        invisible="state not in ('draft', 'submitted', 'approved')"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                        invisible="state not in ('rejected', 'cancelled')"
                        groups="hospital_management.group_hospital_manager,hospital_management.group_hospital_system_administrator"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,submitted,approved,issued"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_movements" type="object"
                            class="oe_stat_button" icon="fa-exchange" invisible="not id">
                            <field name="movement_count" widget="statinfo" string="Movements"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <div class="alert alert-info" role="alert" invisible="state not in ('draft', 'submitted')">
                        <strong>Issue to Department:</strong> source = Central Store, destination = department store.
                        <strong>Transfer Between Departments:</strong> source = one department store, destination = another.
                        <strong>Return to Store:</strong> source = department store, destination = Central Store.
                        Stock moves from source to destination — it is not removed from inventory (only consumption removes it).
                    </div>
                    <group>
                        <group string="Request Information">
                            <field name="department_id" options="{'no_create': True}"
                                readonly="state not in ('draft', 'submitted')"/>
                            <field name="request_type" readonly="state not in ('draft', 'submitted')"/>
                            <field name="priority" readonly="state not in ('draft', 'submitted')"/>
                        </group>
                        <group string="Locations">
                            <field name="source_location_id" options="{'no_create': True}"
                                readonly="state not in ('draft', 'submitted')"/>
                            <field name="destination_location_id" options="{'no_create': True}"
                                readonly="state not in ('draft', 'submitted')"/>
                            <field name="use_transit" readonly="state not in ('draft', 'submitted')"/>
                            <field name="transit_location_id" options="{'no_create': True}"
                                invisible="not use_transit"
                                readonly="state not in ('draft', 'submitted')"/>
                        </group>
                    </group>
                    <group>
                        <group string="Tracking">
                            <field name="requested_by" readonly="1"/>
                            <field name="request_date" readonly="1"/>
                            <field name="approved_by" readonly="1"/>
                            <field name="approved_date" readonly="1"/>
                            <field name="issued_by" readonly="1"/>
                            <field name="issued_date" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Request Lines" name="lines">
                            <field name="line_ids" readonly="state in ('issued', 'returned', 'rejected', 'cancelled')">
                                <list string="Request Lines" editable="bottom">
                                    <field name="item_id" options="{'no_create': True}"/>
                                    <field name="requested_quantity"/>
                                    <field name="approved_quantity"/>
                                    <field name="batch_id"
                                        domain="[('item_id', '=', item_id), ('state', 'not in', ('expired', 'blocked', 'depleted'))]"
                                        options="{'no_create': True}"/>
                                    <field name="issued_quantity" readonly="1"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1" placeholder="Notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- STOCK REQUEST — SEARCH VIEW -->
    <record id="view_hospital_stock_request_search" model="ir.ui.view">
        <field name="name">hospital.stock.request.search</field>
        <field name="model">hospital.stock.request</field>
        <field name="arch" type="xml">
            <search string="Stock Requests">
                <field name="name"/>
                <field name="department_id"/>
                <field name="requested_by"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Issued" name="issued" domain="[('state', '=', 'issued')]"/>
                <filter string="Partially Issued" name="partially_issued" domain="[('state', '=', 'partially_issued')]"/>
                <separator/>
                <filter string="Urgent" name="urgent" domain="[('priority', '=', 'urgent')]"/>
                <filter string="My Requests" name="my_requests" domain="[('requested_by', '=', uid)]"/>
                <separator/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Request Type" name="group_request_type" context="{'group_by': 'request_type'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- STOCK REQUEST — ACTION -->
    <record id="action_hospital_stock_request" model="ir.actions.act_window">
        <field name="name">Stock Requests</field>
        <field name="res_model">hospital.stock.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hospital_stock_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No stock requests yet.</p>
            <p>Create a request to issue stock to a department or return stock to the store.</p>
        </field>
    </record>

</odoo>
