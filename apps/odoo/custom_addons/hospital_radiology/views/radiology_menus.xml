<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="menu_hospital_radiology_root" model="ir.ui.menu">
        <field name="name">Radiology</field>
        <field name="sequence">36</field>
        <field name="parent_id" eval="False"/>
        <field name="web_icon">hospital_management,static/description/hospital.svg</field>
        <field name="groups_id" eval="[(6, 0, [
            ref('hospital_management.group_hospital_system_administrator'),
            ref('hospital_management.group_hospital_manager'),
            ref('hospital_management.group_hospital_receptionist'),
            ref('hospital_management.group_hospital_doctor'),
            ref('hospital_management.group_hospital_nurse'),
            ref('hospital_management.group_hospital_lab_technician'),
            ref('hospital_management.group_hospital_data_protection_officer'),
            ref('base.group_system')
        ])]"/>
    </record>

    <record id="menu_hospital_radiology_requests" model="ir.ui.menu">
        <field name="name">Radiology Requests</field>
        <field name="parent_id" ref="menu_hospital_radiology_root"/>
        <field name="action" eval="'ir.actions.act_window,%d' % ref('action_hospital_radiology_request')"/>
        <field name="sequence">10</field>
        <field name="web_icon" eval="False"/>
    </record>

    <record id="menu_hospital_radiology_results" model="ir.ui.menu">
        <field name="name">Radiology Results</field>
        <field name="parent_id" ref="menu_hospital_radiology_root"/>
        <field name="action" eval="'ir.actions.act_window,%d' % ref('action_hospital_radiology_result')"/>
        <field name="sequence">20</field>
        <field name="web_icon" eval="False"/>
    </record>

    <record id="menu_hospital_radiology_configuration" model="ir.ui.menu">
        <field name="name">Configuration</field>
        <field name="parent_id" ref="menu_hospital_radiology_root"/>
        <field name="sequence">90</field>
        <field name="web_icon" eval="False"/>
        <field name="groups_id" eval="[(6, 0, [
            ref('hospital_management.group_hospital_system_administrator'),
            ref('hospital_management.group_hospital_manager'),
            ref('hospital_management.group_hospital_lab_technician'),
            ref('base.group_system')
        ])]"/>
    </record>

    <record id="menu_hospital_radiology_exams" model="ir.ui.menu">
        <field name="name">Radiology Exams</field>
        <field name="parent_id" ref="menu_hospital_radiology_configuration"/>
        <field name="action" eval="'ir.actions.act_window,%d' % ref('action_hospital_radiology_exam')"/>
        <field name="sequence">10</field>
        <field name="web_icon" eval="False"/>
    </record>
</odoo>
