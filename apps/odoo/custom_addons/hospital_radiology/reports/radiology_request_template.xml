<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_radiology_request">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="request">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>
                            .hospital-report-title {
                                color: #006A4F;
                                font-size: 22px;
                                font-weight: 700;
                                margin-bottom: 4px;
                            }
                            .hospital-report-subtitle {
                                color: #333333;
                                font-size: 16px;
                                font-weight: 600;
                                margin-bottom: 12px;
                            }
                            .hospital-section-title {
                                color: #006A4F;
                                font-size: 14px;
                                font-weight: 700;
                                margin: 12px 0 6px;
                            }
                            .hospital-report-table {
                                width: 100%;
                                border-collapse: collapse;
                                margin-bottom: 10px;
                            }
                            .hospital-report-table th {
                                background: #F3F8F6;
                                color: #333333;
                                font-weight: 700;
                            }
                            .hospital-report-table th,
                            .hospital-report-table td {
                                border: 1px solid #DDDDDD;
                                padding: 5px;
                                font-size: 11px;
                                vertical-align: top;
                            }
                            .hospital-info-table td:first-child,
                            .hospital-info-table td:nth-child(3) {
                                width: 18%;
                                color: #555555;
                                font-weight: 700;
                            }
                            .hospital-empty-note {
                                color: #666666;
                                font-style: italic;
                                margin: 6px 0 10px;
                            }
                        </style>

                        <t t-set="report_title" t-value="'Radiology Request Report'"/>
                        <t t-set="report_ref_label" t-value="'Request Ref'"/>
                        <t t-set="report_ref" t-value="request.name"/>
                        <t t-set="report_date_label" t-value="'Request Date'"/>
                        <t t-set="report_date" t-value="request.request_date"/>
                        <t t-call="hospital_management.hospital_report_header"/>

                        <table class="hospital-report-table hospital-info-table">
                            <tbody>
                                <tr>
                                    <td>Request Reference</td>
                                    <td><span t-field="request.name"/></td>
                                    <td>Request Date</td>
                                    <td><span t-field="request.request_date"/></td>
                                </tr>
                                <tr>
                                    <td>Patient</td>
                                    <td>
                                        <span t-field="request.patient_id.name"/>
                                        <t t-if="request.patient_id.identification_code">
                                            (<span t-field="request.patient_id.identification_code"/>)
                                        </t>
                                    </td>
                                    <td>Physician</td>
                                    <td><span t-field="request.physician_id"/></td>
                                </tr>
                                <tr>
                                    <td>Appointment</td>
                                    <td><span t-out="request.appointment_id.display_name"/></td>
                                    <td>Diagnosis</td>
                                    <td><span t-out="request.diagnosis_id.display_name"/></td>
                                </tr>
                                <tr>
                                    <td>Priority</td>
                                    <td><span t-field="request.priority"/></td>
                                    <td>State</td>
                                    <td><span t-field="request.state"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="hospital-section-title">Requested Exams</div>
                        <t t-if="request.line_ids">
                            <table class="hospital-report-table">
                                <thead>
                                    <tr>
                                        <th>Exam</th>
                                        <th>Modality</th>
                                        <th>Body Part</th>
                                        <th>Contrast Required</th>
                                        <th>Special Instruction</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="request.line_ids" t-as="line">
                                        <td><span t-field="line.exam_id"/></td>
                                        <td><span t-field="line.modality"/></td>
                                        <td><span t-field="line.body_part"/></td>
                                        <td><span t-field="line.contrast_required"/></td>
                                        <td><span t-field="line.special_instruction"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <div class="hospital-empty-note">No requested exams recorded.</div>
                        </t>

                        <div class="hospital-section-title">Clinical Indication</div>
                        <table class="hospital-report-table hospital-info-table">
                            <tbody>
                                <tr>
                                    <td>Clinical Indication</td>
                                    <td colspan="3"><span t-field="request.clinical_indication"/></td>
                                </tr>
                                <tr>
                                    <td>Instructions</td>
                                    <td colspan="3"><span t-field="request.instructions"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="hospital-footer-note" style="color: #555555; font-size: 11px; margin-top: 16px;">
                            This report is generated from YOYA Hospital Ethiopian Hospital ERP.
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
