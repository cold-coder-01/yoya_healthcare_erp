<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_radiology_result">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="result">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>
                            .hospital-report-title {
                                color: #006A4F;
                                font-size: 22px;
                                font-weight: 700;
                                margin-bottom: 4px;
                            }
                            .hospital-report-subtitle {
                                color: #333333;
                                font-size: 16px;
                                font-weight: 600;
                                margin-bottom: 12px;
                            }
                            .hospital-section-title {
                                color: #006A4F;
                                font-size: 14px;
                                font-weight: 700;
                                margin: 12px 0 6px;
                            }
                            .hospital-report-table {
                                width: 100%;
                                border-collapse: collapse;
                                margin-bottom: 10px;
                            }
                            .hospital-report-table th {
                                background: #F3F8F6;
                                color: #333333;
                                font-weight: 700;
                            }
                            .hospital-report-table th,
                            .hospital-report-table td {
                                border: 1px solid #DDDDDD;
                                padding: 5px;
                                font-size: 11px;
                                vertical-align: top;
                            }
                            .hospital-info-table td:first-child,
                            .hospital-info-table td:nth-child(3) {
                                width: 18%;
                                color: #555555;
                                font-weight: 700;
                            }
                            .hospital-empty-note {
                                color: #666666;
                                font-style: italic;
                                margin: 6px 0 10px;
                            }
                        </style>

                        <t t-set="report_title" t-value="'Radiology Result Report'"/>
                        <t t-set="report_ref_label" t-value="'Result Ref'"/>
                        <t t-set="report_ref" t-value="result.name"/>
                        <t t-set="report_date_label" t-value="'Result Date'"/>
                        <t t-set="report_date" t-value="result.result_date"/>
                        <t t-call="hospital_management.hospital_report_header"/>

                        <table class="hospital-report-table hospital-info-table">
                            <tbody>
                                <tr>
                                    <td>Result Reference</td>
                                    <td><span t-field="result.name"/></td>
                                    <td>Result Date</td>
                                    <td><span t-field="result.result_date"/></td>
                                </tr>
                                <tr>
                                    <td>Request</td>
                                    <td><span t-field="result.request_id"/></td>
                                    <td>State</td>
                                    <td><span t-field="result.state"/></td>
                                </tr>
                                <tr>
                                    <td>Patient</td>
                                    <td>
                                        <span t-field="result.patient_id.name"/>
                                        <t t-if="result.patient_id.identification_code">
                                            (<span t-field="result.patient_id.identification_code"/>)
                                        </t>
                                    </td>
                                    <td>Physician</td>
                                    <td><span t-field="result.physician_id"/></td>
                                </tr>
                                <tr>
                                    <td>Radiologist / Reporter</td>
                                    <td colspan="3"><span t-field="result.radiologist_id"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="hospital-section-title">Result Lines</div>
                        <t t-if="result.line_ids">
                            <table class="hospital-report-table">
                                <thead>
                                    <tr>
                                        <th>Exam</th>
                                        <th>Modality</th>
                                        <th>Body Part</th>
                                        <th>Contrast Used</th>
                                        <th>Summary</th>
                                        <th>Notes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="result.line_ids" t-as="line">
                                        <td><span t-field="line.exam_id"/></td>
                                        <td><span t-field="line.modality"/></td>
                                        <td><span t-field="line.body_part"/></td>
                                        <td><span t-field="line.contrast_used"/></td>
                                        <td><span t-field="line.result_summary"/></td>
                                        <td><span t-field="line.notes"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <div class="hospital-empty-note">No result lines recorded.</div>
                        </t>

                        <div class="hospital-section-title">Report</div>
                        <table class="hospital-report-table hospital-info-table">
                            <tbody>
                                <tr>
                                    <td>Findings</td>
                                    <td colspan="3"><span t-field="result.findings"/></td>
                                </tr>
                                <tr>
                                    <td>Impression</td>
                                    <td colspan="3"><span t-field="result.impression"/></td>
                                </tr>
                                <tr>
                                    <td>Recommendations</td>
                                    <td colspan="3"><span t-field="result.recommendations"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="hospital-footer-note" style="color: #555555; font-size: 11px; margin-top: 16px;">
                            This report is generated from YOYA Hospital Ethiopian Hospital ERP.
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
