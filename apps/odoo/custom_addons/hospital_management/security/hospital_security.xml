<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_hospital_management" model="ir.module.category">
        <field name="name">Hospital Management</field>
        <field name="description">Security roles for Ethiopian Hospital ERP.</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_hospital_receptionist" model="res.groups">
        <field name="name">Hospital Receptionist</field>
        <field name="category_id" ref="module_category_hospital_management"/>
    </record>

    <record id="group_hospital_doctor" model="res.groups">
        <field name="name">Hospital Doctor</field>
        <field name="category_id" ref="module_category_hospital_management"/>
    </record>

    <record id="group_hospital_nurse" model="res.groups">
        <field name="name">Hospital Nurse</field>
        <field name="category_id" ref="module_category_hospital_management"/>
    </record>

    <record id="group_hospital_pharmacist" model="res.groups">
        <field name="name">Hospital Pharmacist</field>
        <field name="category_id" ref="module_category_hospital_management"/>
    </record>

    <record id="group_hospital_lab_technician" model="res.groups">
        <field name="name">Hospital Lab Technician</field>
        <field name="category_id" ref="module_category_hospital_management"/>
    </record>

    <record id="group_hospital_accountant" model="res.groups">
        <field name="name">Hospital Accountant</field>
        <field name="category_id" ref="module_category_hospital_management"/>
    </record>

    <record id="group_hospital_manager" model="res.groups">
        <field name="name">Hospital Manager</field>
        <field name="category_id" ref="module_category_hospital_management"/>
        <field name="implied_ids" eval="[(4, ref('group_hospital_receptionist')), (4, ref('group_hospital_doctor')), (4, ref('group_hospital_nurse'))]"/>
    </record>

    <record id="group_hospital_data_protection_officer" model="res.groups">
        <field name="name">Data Protection Officer</field>
        <field name="category_id" ref="module_category_hospital_management"/>
    </record>

    <record id="group_hospital_system_administrator" model="res.groups">
        <field name="name">Hospital System Administrator</field>
        <field name="category_id" ref="module_category_hospital_management"/>
        <field name="implied_ids" eval="[(4, ref('group_hospital_manager')), (4, ref('group_hospital_data_protection_officer'))]"/>
    </record>
</odoo>
