<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hospital_patient_tag_list" model="ir.ui.view">
        <field name="name">hospital.patient.tag.list</field>
        <field name="model">hospital.patient.tag</field>
        <field name="arch" type="xml">
            <list string="Patient Tags">
                <field name="name"/>
                <field name="color"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_patient_tag_form" model="ir.ui.view">
        <field name="name">hospital.patient.tag.form</field>
        <field name="model">hospital.patient.tag</field>
        <field name="arch" type="xml">
            <form string="Patient Tag">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="color" widget="color_picker"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hospital_patient_tag_search" model="ir.ui.view">
        <field name="name">hospital.patient.tag.search</field>
        <field name="model">hospital.patient.tag</field>
        <field name="arch" type="xml">
            <search string="Patient Tags">
                <field name="name"/>
                <field name="description"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_hospital_patient_tag" model="ir.actions.act_window">
        <field name="name">Patient Tags</field>
        <field name="res_model">hospital.patient.tag</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hospital_patient_tag_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create tags to classify patient records.
            </p>
        </field>
    </record>
</odoo>
