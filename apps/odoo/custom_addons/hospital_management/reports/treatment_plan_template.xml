<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_treatment_plan">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="plan">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>
                            .hospital-report-title {
                                color: #006A4F;
                                font-size: 22px;
                                font-weight: 700;
                                margin-bottom: 4px;
                            }
                            .hospital-report-subtitle {
                                color: #333333;
                                font-size: 16px;
                                font-weight: 600;
                                margin-bottom: 12px;
                            }
                            .hospital-section-title {
                                color: #006A4F;
                                font-size: 14px;
                                font-weight: 700;
                                margin: 12px 0 6px;
                            }
                            .hospital-report-table {
                                width: 100%;
                                border-collapse: collapse;
                                margin-bottom: 10px;
                            }
                            .hospital-report-table th {
                                background: #F3F8F6;
                                color: #333333;
                                font-weight: 700;
                            }
                            .hospital-report-table th,
                            .hospital-report-table td {
                                border: 1px solid #DDDDDD;
                                padding: 5px;
                                font-size: 11px;
                                vertical-align: top;
                            }
                            .hospital-info-table td:first-child,
                            .hospital-info-table td:nth-child(3) {
                                width: 18%;
                                color: #555555;
                                font-weight: 700;
                            }
                            .hospital-empty-note {
                                color: #666666;
                                font-style: italic;
                                margin: 6px 0 10px;
                            }
                            .hospital-footer-note {
                                color: #555555;
                                font-size: 11px;
                                margin-top: 16px;
                            }
                        </style>

                        <t t-set="report_title" t-value="'Treatment Plan Report'"/>
                        <t t-set="report_ref_label" t-value="'Plan Ref'"/>
                        <t t-set="report_ref" t-value="plan.name"/>
                        <t t-set="report_date_label" t-value="'Start Date'"/>
                        <t t-set="report_date" t-value="plan.start_date"/>
                        <t t-call="hospital_management.hospital_report_header"/>

                        <table class="hospital-report-table hospital-info-table">
                            <tbody>
                                <tr>
                                    <td>Treatment Plan Reference</td>
                                    <td><span t-field="plan.name"/></td>
                                    <td>Date</td>
                                    <td><span t-field="plan.plan_date"/></td>
                                </tr>
                                <tr>
                                    <td>Patient</td>
                                    <td>
                                        <span t-field="plan.patient_id.name"/>
                                        <t t-if="plan.patient_id.identification_code">
                                            (<span t-field="plan.patient_id.identification_code"/>)
                                        </t>
                                    </td>
                                    <td>Physician</td>
                                    <td><span t-field="plan.physician_id"/></td>
                                </tr>
                                <tr>
                                    <td>Appointment</td>
                                    <td><span t-out="plan.appointment_id.display_name"/></td>
                                    <td>Evaluation</td>
                                    <td><span t-out="plan.evaluation_id.display_name"/></td>
                                </tr>
                                <tr>
                                    <td>Diagnosis</td>
                                    <td><span t-out="plan.diagnosis_id.display_name"/></td>
                                    <td>Prescription</td>
                                    <td><span t-field="plan.prescription_id"/></td>
                                </tr>
                                <tr>
                                    <td>Priority</td>
                                    <td><span t-field="plan.priority"/></td>
                                    <td>State</td>
                                    <td><span t-field="plan.state"/></td>
                                </tr>
                                <tr>
                                    <td>Start Date</td>
                                    <td><span t-field="plan.start_date"/></td>
                                    <td>End Date</td>
                                    <td><span t-field="plan.end_date"/></td>
                                </tr>
                                <tr>
                                    <td>Follow-up Required</td>
                                    <td><span t-field="plan.follow_up_required"/></td>
                                    <td>Follow-up Date</td>
                                    <td><span t-field="plan.follow_up_date"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="hospital-section-title">Treatment Goal</div>
                        <table class="hospital-report-table hospital-info-table">
                            <tbody>
                                <tr>
                                    <td>Goal</td>
                                    <td colspan="3"><span t-field="plan.treatment_goal"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="hospital-section-title">Treatment Lines</div>
                        <t t-if="plan.line_ids">
                            <table class="hospital-report-table">
                                <thead>
                                    <tr>
                                        <th>Type</th>
                                        <th>Description</th>
                                        <th>Frequency</th>
                                        <th>Duration</th>
                                        <th>Responsible Person</th>
                                        <th>Instructions</th>
                                        <th>State</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="plan.line_ids" t-as="line">
                                        <td><span t-field="line.treatment_type"/></td>
                                        <td><span t-field="line.description"/></td>
                                        <td><span t-field="line.frequency"/></td>
                                        <td><span t-field="line.duration"/></td>
                                        <td><span t-field="line.responsible_person"/></td>
                                        <td><span t-field="line.instructions"/></td>
                                        <td><span t-field="line.state"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <div class="hospital-empty-note">No treatment lines recorded.</div>
                        </t>

                        <div class="hospital-section-title">Instructions</div>
                        <table class="hospital-report-table hospital-info-table">
                            <tbody>
                                <tr>
                                    <td>Doctor Instructions</td>
                                    <td colspan="3"><span t-field="plan.doctor_instructions"/></td>
                                </tr>
                                <tr>
                                    <td>Patient Instructions</td>
                                    <td colspan="3"><span t-field="plan.patient_instructions"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="hospital-section-title">Notes</div>
                        <table class="hospital-report-table hospital-info-table">
                            <tbody>
                                <tr>
                                    <td>Notes</td>
                                    <td colspan="3"><span t-field="plan.notes"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="hospital-footer-note">
                            This report is generated from YOYA Hospital Ethiopian Hospital ERP.
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
