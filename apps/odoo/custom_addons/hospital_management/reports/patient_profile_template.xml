<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_patient_profile">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="patient">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>
                            .hospital-report-title {
                                color: #006A4F;
                                font-size: 22px;
                                font-weight: 700;
                                margin-bottom: 4px;
                            }
                            .hospital-report-subtitle {
                                color: #333333;
                                font-size: 16px;
                                font-weight: 600;
                                margin-bottom: 14px;
                            }
                            .hospital-report-meta {
                                color: #555555;
                                font-size: 12px;
                                margin-bottom: 14px;
                            }
                            .hospital-section-title {
                                color: #006A4F;
                                font-size: 15px;
                                font-weight: 700;
                                border-bottom: 1px solid #CCCCCC;
                                padding-bottom: 4px;
                                margin: 16px 0 8px;
                            }
                            .hospital-report-table {
                                width: 100%;
                                border-collapse: collapse;
                                margin-bottom: 10px;
                            }
                            .hospital-report-table th {
                                background: #F3F8F6;
                                color: #333333;
                                font-weight: 700;
                            }
                            .hospital-report-table th,
                            .hospital-report-table td {
                                border: 1px solid #DDDDDD;
                                padding: 5px;
                                font-size: 11px;
                                vertical-align: top;
                            }
                            .hospital-info-table td:first-child {
                                width: 24%;
                                color: #555555;
                                font-weight: 700;
                            }
                            .hospital-empty-note {
                                color: #666666;
                                font-style: italic;
                                margin: 6px 0 10px;
                            }
                            .hospital-clinical-note {
                                color: #666666;
                                font-size: 11px;
                                margin-bottom: 8px;
                            }
                        </style>

                        <t t-set="report_title" t-value="'Patient Profile Report'"/>
                        <t t-set="report_ref_label" t-value="'Patient ID'"/>
                        <t t-set="report_ref" t-value="patient.identification_code or patient.display_name"/>
                        <t t-set="report_date_label" t-value="False"/>
                        <t t-set="report_date" t-value="False"/>
                        <t t-call="hospital_management.hospital_report_header"/>
                        <div class="hospital-report-meta">
                            <strong>Print Date:</strong>
                            <span t-esc="time.strftime('%Y-%m-%d')"/>
                            <br/>
                            <strong>Patient Identification Code:</strong>
                            <span t-field="patient.identification_code"/>
                            <br/>
                            <strong>Patient Name:</strong>
                            <span t-field="patient.name"/>
                        </div>

                        <div class="hospital-section-title">Patient Identity</div>
                        <table class="hospital-report-table hospital-info-table">
                            <tbody>
                                <tr>
                                    <td>Name</td>
                                    <td><span t-field="patient.name"/></td>
                                    <td>Identification Code</td>
                                    <td><span t-field="patient.identification_code"/></td>
                                </tr>
                                <tr>
                                    <td>Title</td>
                                    <td><span t-field="patient.title"/></td>
                                    <td>Gender</td>
                                    <td><span t-field="patient.gender"/></td>
                                </tr>
                                <tr>
                                    <td>Date of Birth</td>
                                    <td><span t-field="patient.date_of_birth"/></td>
                                    <td>Age</td>
                                    <td><span t-field="patient.age"/></td>
                                </tr>
                                <tr>
                                    <td>Primary Care Doctor</td>
                                    <td><span t-field="patient.primary_care_doctor_id"/></td>
                                    <td>Departments</td>
                                    <td><span t-esc="', '.join(patient.department_ids.mapped('display_name'))"/></td>
                                </tr>
                                <tr>
                                    <td>Blood Group</td>
                                    <td><span t-field="patient.blood_group"/></td>
                                    <td>Patient Tags</td>
                                    <td><span t-esc="', '.join(patient.patient_tag_ids.mapped('display_name'))"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="hospital-section-title">Contact and Demographic Information</div>
                        <table class="hospital-report-table hospital-info-table">
                            <tbody>
                                <tr>
                                    <td>Address</td>
                                    <td><span t-field="patient.address"/></td>
                                    <td>City</td>
                                    <td><span t-field="patient.city"/></td>
                                </tr>
                                <tr>
                                    <td>State</td>
                                    <td><span t-field="patient.state"/></td>
                                    <td>ZIP</td>
                                    <td><span t-field="patient.zip_code"/></td>
                                </tr>
                                <tr>
                                    <td>Country</td>
                                    <td><span t-field="patient.country"/></td>
                                    <td>Phone</td>
                                    <td><span t-field="patient.phone"/></td>
                                </tr>
                                <tr>
                                    <td>Mobile</td>
                                    <td><span t-field="patient.mobile"/></td>
                                    <td>Email</td>
                                    <td><span t-field="patient.email"/></td>
                                </tr>
                                <tr>
                                    <td>Nationality</td>
                                    <td><span t-field="patient.nationality"/></td>
                                    <td>Government Identity</td>
                                    <td><span t-field="patient.government_identity"/></td>
                                </tr>
                                <tr>
                                    <td>Passport Number</td>
                                    <td><span t-field="patient.passport_number"/></td>
                                    <td>Occupation</td>
                                    <td><span t-field="patient.occupation"/></td>
                                </tr>
                                <tr>
                                    <td>Patient Education</td>
                                    <td><span t-field="patient.patient_education"/></td>
                                    <td>Religion</td>
                                    <td><span t-field="patient.religion"/></td>
                                </tr>
                                <tr>
                                    <td>Marital Status</td>
                                    <td colspan="3"><span t-field="patient.marital_status"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="hospital-section-title">Emergency / Family Summary</div>
                        <table class="hospital-report-table hospital-info-table">
                            <tbody>
                                <tr>
                                    <td>Emergency Contact Name</td>
                                    <td><span t-field="patient.emergency_contact_name"/></td>
                                    <td>Emergency Contact Phone</td>
                                    <td><span t-field="patient.emergency_contact_phone"/></td>
                                </tr>
                                <tr>
                                    <td>Family History</td>
                                    <td colspan="3"><span t-field="patient.family_history"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="hospital-section-title">Latest Clinical Assessment</div>
                        <div class="hospital-clinical-note">
                            Clinical assessment values are based on the latest completed patient evaluation.
                        </div>
                        <table class="hospital-report-table hospital-info-table">
                            <tbody>
                                <tr>
                                    <td>Weight</td>
                                    <td><span t-field="patient.latest_weight"/></td>
                                    <td>Height</td>
                                    <td><span t-field="patient.latest_height"/></td>
                                </tr>
                                <tr>
                                    <td>Temperature</td>
                                    <td><span t-field="patient.latest_temperature"/></td>
                                    <td>Heart Rate</td>
                                    <td><span t-field="patient.latest_heart_rate"/></td>
                                </tr>
                                <tr>
                                    <td>Respiratory Rate</td>
                                    <td><span t-field="patient.latest_respiratory_rate"/></td>
                                    <td>Systolic BP</td>
                                    <td><span t-field="patient.latest_systolic_bp"/></td>
                                </tr>
                                <tr>
                                    <td>Diastolic BP</td>
                                    <td><span t-field="patient.latest_diastolic_bp"/></td>
                                    <td>SpO2</td>
                                    <td><span t-field="patient.latest_spo2"/></td>
                                </tr>
                                <tr>
                                    <td>RBS</td>
                                    <td><span t-field="patient.latest_rbs"/></td>
                                    <td>BMI</td>
                                    <td><span t-field="patient.latest_bmi"/></td>
                                </tr>
                                <tr>
                                    <td>BMI State</td>
                                    <td><span t-field="patient.latest_bmi_state"/></td>
                                    <td>Pain Level</td>
                                    <td><span t-field="patient.latest_pain_level"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="hospital-section-title">Diagnoses Summary</div>
                        <t t-if="patient.diagnosis_ids">
                            <table class="hospital-report-table">
                                <thead>
                                    <tr>
                                        <th>Diagnosis Date</th>
                                        <th>Disease</th>
                                        <th>Category</th>
                                        <th>Physician</th>
                                        <th>Type</th>
                                        <th>Severity</th>
                                        <th>Status</th>
                                        <th>Notes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="patient.diagnosis_ids" t-as="diagnosis">
                                        <td><span t-field="diagnosis.diagnosis_date"/></td>
                                        <td><span t-field="diagnosis.disease_id"/></td>
                                        <td><span t-field="diagnosis.category_id"/></td>
                                        <td><span t-field="diagnosis.physician_id"/></td>
                                        <td><span t-field="diagnosis.diagnosis_type"/></td>
                                        <td><span t-field="diagnosis.severity"/></td>
                                        <td><span t-field="diagnosis.status"/></td>
                                        <td><span t-field="diagnosis.notes"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <div class="hospital-empty-note">No diagnosis records found.</div>
                        </t>

                        <div class="hospital-section-title">Documents Summary</div>
                        <t t-if="patient.document_ids">
                            <table class="hospital-report-table">
                                <thead>
                                    <tr>
                                        <th>Document Name</th>
                                        <th>Type</th>
                                        <th>Date</th>
                                        <th>Uploaded By</th>
                                        <th>Description</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="patient.document_ids" t-as="document">
                                        <td><span t-field="document.name"/></td>
                                        <td><span t-field="document.document_type"/></td>
                                        <td><span t-field="document.document_date"/></td>
                                        <td><span t-field="document.uploaded_by"/></td>
                                        <td><span t-field="document.description"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <div class="hospital-empty-note">No patient documents found.</div>
                        </t>

                        <div class="hospital-section-title">Notes</div>
                        <table class="hospital-report-table hospital-info-table">
                            <tbody>
                                <tr>
                                    <td>General Notes</td>
                                    <td><span t-field="patient.notes"/></td>
                                </tr>
                                <tr>
                                    <td>Disease History Notes</td>
                                    <td><span t-field="patient.disease_history"/></td>
                                </tr>
                                <tr>
                                    <td>Past Medical History</td>
                                    <td><span t-field="patient.past_medical_history"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="hospital-footer-note" style="color: #555555; font-size: 11px; margin-top: 16px;">
                            This report is generated from YOYA Hospital Ethiopian Hospital ERP.
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
