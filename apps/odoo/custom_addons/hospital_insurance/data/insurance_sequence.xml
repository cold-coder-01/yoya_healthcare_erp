<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sequence_patient_coverage" model="ir.sequence">
        <field name="name">Patient Coverage Sequence</field>
        <field name="code">hospital.patient.coverage</field>
        <field name="prefix">COV</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
    </record>

    <record id="sequence_guarantee_letter" model="ir.sequence">
        <field name="name">Guarantee Letter Sequence</field>
        <field name="code">hospital.guarantee.letter</field>
        <field name="prefix">GUAR</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
    </record>

    <record id="sequence_insurance_claim" model="ir.sequence">
        <field name="name">Insurance Claim Sequence</field>
        <field name="code">hospital.insurance.claim</field>
        <field name="prefix">CLAIM</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
    </record>
</odoo>
