<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hospital_insurance_claim_list" model="ir.ui.view">
        <field name="name">hospital.insurance.claim.list</field>
        <field name="model">hospital.insurance.claim</field>
        <field name="arch" type="xml">
            <list string="Insurance Claims">
                <field name="name"/>
                <field name="claim_date"/>
                <field name="patient_id"/>
                <field name="provider_id"/>
                <field name="bill_id" optional="show"/>
                <field name="claim_amount"/>
                <field name="approved_amount" optional="show"/>
                <field name="amount_paid_by_payer" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-primary="state in ('submitted', 'under_review')"
                    decoration-success="state in ('approved', 'paid')"
                    decoration-warning="state == 'partially_approved'"
                    decoration-danger="state == 'rejected'"
                    decoration-muted="state == 'cancelled'"
                />
            </list>
        </field>
    </record>

    <record id="view_hospital_insurance_claim_form" model="ir.ui.view">
        <field name="name">hospital.insurance.claim.form</field>
        <field name="model">hospital.insurance.claim</field>
        <field name="arch" type="xml">
            <form string="Insurance Claim">
                <header>
                    <button name="action_submit" string="Submit Claim" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_mark_under_review" string="Mark Under Review"
                            type="object" invisible="state != 'submitted'"/>
                    <button name="action_approve" string="Approve Claim" type="object"
                            class="btn-primary"
                            invisible="state not in ('submitted', 'under_review')"/>
                    <button name="action_reject" string="Reject Claim" type="object"
                            invisible="state not in ('submitted', 'under_review')"/>
                    <button name="action_register_payer_payment"
                            string="Register Payer Payment" type="object"
                            class="btn-primary"
                            invisible="state not in ('approved', 'partially_approved')"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft', 'submitted', 'under_review')"/>
                    <button name="action_reset_to_draft" string="Reset to Draft"
                            type="object"
                            invisible="state not in ('rejected', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Patient / Source">
                            <field name="patient_id"/>
                            <field name="admission_id"/>
                            <field name="bill_id"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Payer / Authorization">
                            <field name="provider_id"/>
                            <field name="coverage_id"/>
                            <field name="guarantee_id"/>
                            <field name="claim_date"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Claim Lines" name="claim_lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="description"/>
                                    <field name="source_type"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal"/>
                                    <field name="coverage_percent"/>
                                    <field name="claimed_amount"/>
                                    <field name="approved_amount"/>
                                    <field name="rejected_amount"/>
                                    <field name="patient_share"/>
                                    <field name="payer_share"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="claim_amount"/>
                            </group>
                        </page>
                        <page string="Payment / Approval" name="payment_approval">
                            <group>
                                <group string="Approval">
                                    <field name="approved_amount"/>
                                    <field name="rejected_amount"/>
                                    <field name="approved_date"/>
                                    <field name="rejected_date"/>
                                    <field name="submitted_date"/>
                                </group>
                                <group string="Payment / Responsibility">
                                    <field name="payer_responsibility_amount"/>
                                    <field name="patient_responsibility_amount"/>
                                    <field name="amount_paid_by_payer"/>
                                    <field name="amount_due_from_payer"/>
                                    <field name="paid_date"/>
                                </group>
                            </group>
                            <group>
                                <field name="rejection_reason"
                                       invisible="state != 'rejected'"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hospital_insurance_claim_search" model="ir.ui.view">
        <field name="name">hospital.insurance.claim.search</field>
        <field name="model">hospital.insurance.claim</field>
        <field name="arch" type="xml">
            <search string="Insurance Claims">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="provider_id"/>
                <field name="bill_id"/>
                <filter name="filter_submitted" string="Submitted"
                        domain="[('state', '=', 'submitted')]"/>
                <filter name="filter_under_review" string="Under Review"
                        domain="[('state', '=', 'under_review')]"/>
                <filter name="filter_approved" string="Approved"
                        domain="[('state', 'in', ('approved', 'partially_approved'))]"/>
                <filter name="filter_paid" string="Paid"
                        domain="[('state', '=', 'paid')]"/>
                <separator/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_provider" string="Payer"
                            context="{'group_by': 'provider_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hospital_insurance_claim" model="ir.actions.act_window">
        <field name="name">Insurance Claims</field>
        <field name="res_model">hospital.insurance.claim</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hospital_insurance_claim_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No insurance claims yet</p>
            <p>Claims are created from patient bills. Open a non-cash bill and use
               <b>Create Insurance Claim</b>.</p>
        </field>
    </record>
</odoo>
