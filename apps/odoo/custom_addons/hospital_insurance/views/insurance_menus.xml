<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="menu_hospital_insurance_root" model="ir.ui.menu">
        <field name="name">Insurance</field>
        <field name="sequence">55</field>
        <field name="parent_id" eval="False"/>
        <field name="web_icon">hospital_management,static/description/hospital.svg</field>
        <field name="groups_id" eval="[(6, 0, [
            ref('hospital_management.group_hospital_system_administrator'),
            ref('hospital_management.group_hospital_manager'),
            ref('hospital_management.group_hospital_accountant'),
            ref('hospital_management.group_hospital_receptionist'),
            ref('hospital_management.group_hospital_doctor'),
            ref('hospital_management.group_hospital_nurse'),
            ref('hospital_management.group_hospital_pharmacist'),
            ref('hospital_management.group_hospital_lab_technician'),
            ref('hospital_management.group_hospital_data_protection_officer'),
            ref('base.group_system')
        ])]"/>
    </record>

    <record id="menu_hospital_insurance_providers" model="ir.ui.menu">
        <field name="name">Providers / Payers</field>
        <field name="parent_id" ref="menu_hospital_insurance_root"/>
        <field name="action" eval="'ir.actions.act_window,%d' % ref('action_hospital_insurance_provider')"/>
        <field name="sequence">10</field>
    </record>

    <record id="menu_hospital_insurance_coverages" model="ir.ui.menu">
        <field name="name">Patient Coverages</field>
        <field name="parent_id" ref="menu_hospital_insurance_root"/>
        <field name="action" eval="'ir.actions.act_window,%d' % ref('action_hospital_patient_coverage')"/>
        <field name="sequence">20</field>
    </record>

    <record id="menu_hospital_insurance_guarantees" model="ir.ui.menu">
        <field name="name">Guarantee Letters</field>
        <field name="parent_id" ref="menu_hospital_insurance_root"/>
        <field name="action" eval="'ir.actions.act_window,%d' % ref('action_hospital_guarantee_letter')"/>
        <field name="sequence">30</field>
    </record>

    <record id="menu_hospital_insurance_claims" model="ir.ui.menu">
        <field name="name">Insurance Claims</field>
        <field name="parent_id" ref="menu_hospital_insurance_root"/>
        <field name="action" eval="'ir.actions.act_window,%d' % ref('action_hospital_insurance_claim')"/>
        <field name="sequence">40</field>
    </record>

    <record id="menu_hospital_insurance_configuration" model="ir.ui.menu">
        <field name="name">Configuration</field>
        <field name="parent_id" ref="menu_hospital_insurance_root"/>
        <field name="sequence">90</field>
        <field name="groups_id" eval="[(6, 0, [
            ref('hospital_management.group_hospital_system_administrator'),
            ref('hospital_management.group_hospital_manager'),
            ref('hospital_management.group_hospital_accountant'),
            ref('base.group_system')
        ])]"/>
    </record>

    <record id="menu_hospital_insurance_configuration_providers" model="ir.ui.menu">
        <field name="name">Providers / Payers</field>
        <field name="parent_id" ref="menu_hospital_insurance_configuration"/>
        <field name="action" eval="'ir.actions.act_window,%d' % ref('action_hospital_insurance_provider')"/>
        <field name="sequence">10</field>
    </record>
</odoo>
