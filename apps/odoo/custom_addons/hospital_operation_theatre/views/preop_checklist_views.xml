<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hospital_preop_checklist_list" model="ir.ui.view">
        <field name="name">hospital.preop.checklist.list</field>
        <field name="model">hospital.preop.checklist</field>
        <field name="arch" type="xml">
            <list string="Pre-op Checklists"
                decoration-muted="state == 'cancelled'"
                decoration-success="state == 'completed'">
                <field name="name"/>
                <field name="surgery_id"/>
                <field name="patient_id"/>
                <field name="checklist_date"/>
                <field name="completed_by"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_preop_checklist_form" model="ir.ui.view">
        <field name="name">hospital.preop.checklist.form</field>
        <field name="model">hospital.preop.checklist</field>
        <field name="arch" type="xml">
            <form string="Pre-op Checklist">
                <header>
                    <button name="action_complete" string="Complete Checklist" type="object"
                        class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                        invisible="state == 'cancelled'"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                        invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="surgery_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="patient_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="checklist_date"/>
                            <field name="completed_by" readonly="1"/>
                        </group>
                    </group>
                    <group string="Safety &amp; Readiness Checks">
                        <group>
                            <field name="identity_confirmed"/>
                            <field name="consent_verified"/>
                            <field name="fasting_confirmed"/>
                            <field name="allergies_checked"/>
                            <field name="medication_reviewed"/>
                            <field name="vitals_checked"/>
                            <field name="lab_results_checked"/>
                        </group>
                        <group>
                            <field name="blood_prepared"/>
                            <field name="site_marked"/>
                            <field name="anesthesia_assessment_done"/>
                            <field name="equipment_ready"/>
                            <field name="surgical_instruments_ready"/>
                            <field name="infection_prevention_done"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="checklist_notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hospital_preop_checklist_search" model="ir.ui.view">
        <field name="name">hospital.preop.checklist.search</field>
        <field name="model">hospital.preop.checklist</field>
        <field name="arch" type="xml">
            <search string="Pre-op Checklists">
                <field name="name"/>
                <field name="surgery_id"/>
                <field name="patient_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Surgery" name="group_surgery" context="{'group_by': 'surgery_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hospital_preop_checklist" model="ir.actions.act_window">
        <field name="name">Pre-op Checklists</field>
        <field name="res_model">hospital.preop.checklist</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hospital_preop_checklist_search"/>
    </record>

</odoo>
