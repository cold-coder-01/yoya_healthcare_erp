<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_yoya_emr_patient_list" model="ir.ui.view">
        <field name="name">yoya.emr.patient.list</field>
        <field name="model">yoya.emr.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="patient_number"/>
                <field name="name"/>
                <field name="gender"/>
                <field name="date_of_birth"/>
                <field name="phone"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_yoya_emr_patient_form" model="ir.ui.view">
        <field name="name">yoya.emr.patient.form</field>
        <field name="model">yoya.emr.patient</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="patient_number"/>
                            <field name="name"/>
                            <field name="gender"/>
                        </group>
                        <group>
                            <field name="date_of_birth"/>
                            <field name="phone"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_yoya_emr_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">yoya.emr.patient</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
