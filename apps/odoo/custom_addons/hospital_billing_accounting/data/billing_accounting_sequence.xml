        <field name="padding">6</field>
        <field name="number_next">1</field>
    </record>
    <record id="sequence_hospital_patient_advance_application" model="ir.sequence">
        <field name="name">Hospital Patient Advance Application Sequence</field>
        <field name="code">hospital.patient.advance.application.sequence</field>
        <field name="prefix">ADVAPP</field>
        <field name="padding">6</field>
        <field name="number_next">1</field>
    </record>
