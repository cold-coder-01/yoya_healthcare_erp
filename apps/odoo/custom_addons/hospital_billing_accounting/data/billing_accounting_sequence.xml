        <field name="name">Hospital Accounting Posting Log Sequence</field>
        <field name="code">hospital.accounting.posting.log.sequence</field>
        <field name="prefix">HACC</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
    </record>
    <record id="sequence_hospital_invoice_batch" model="ir.sequence">
