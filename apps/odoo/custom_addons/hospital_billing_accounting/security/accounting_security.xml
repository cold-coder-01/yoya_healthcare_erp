<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hospital_management.group_hospital_accountant" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>
    <record id="hospital_management.group_hospital_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>
    <record id="hospital_management.group_hospital_system_administrator" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>
    <record id="rule_billing_accounting_config_company" model="ir.rule">
        <field name="name">Hospital accounting configuration: allowed companies</field>
        <field name="model_id" ref="model_hospital_billing_accounting_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hospital_management.group_hospital_accountant')), (4, ref('hospital_management.group_hospital_manager')), (4, ref('hospital_management.group_hospital_system_administrator')), (4, ref('hospital_management.group_hospital_data_protection_officer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_hospital_invoice_batch_company" model="ir.rule">
        <field name="name">Hospital invoice batches: allowed companies</field>
        <field name="model_id" ref="model_hospital_invoice_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hospital_management.group_hospital_accountant')), (4, ref('hospital_management.group_hospital_manager')), (4, ref('hospital_management.group_hospital_system_administrator'))]"/>
    </record>
    <record id="rule_hospital_invoice_allocation_company" model="ir.rule">
        <field name="name">Hospital invoice provenance: allowed companies</field>
        <field name="model_id" ref="model_hospital_charge_invoice_allocation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hospital_management.group_hospital_accountant')), (4, ref('hospital_management.group_hospital_manager')), (4, ref('hospital_management.group_hospital_system_administrator'))]"/>
    </record>
</odoo>
