<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_accounting_posting_log_list" model="ir.ui.view">
        <field name="name">hospital.accounting.posting.log.list</field>
        <field name="model">hospital.accounting.posting.log</field>
        <field name="arch" type="xml">
            <list string="Posting Logs" create="false">
                <field name="name"/>
                <field name="posting_date"/>
                <field name="event_type"/>
                <field name="status"
                       decoration-success="status == 'success'"
                       decoration-danger="status == 'failed'"
                       widget="badge"/>
                <field name="bill_id"/>
                <field name="payment_id"/>
                <field name="account_move_id"/>
                <field name="debit_total"/>
                <field name="credit_total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="posted_by"/>
            </list>
        </field>
    </record>

    <record id="view_accounting_posting_log_form" model="ir.ui.view">
        <field name="name">hospital.accounting.posting.log.form</field>
        <field name="model">hospital.accounting.posting.log</field>
        <field name="arch" type="xml">
            <form string="Posting Log" create="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="event_type"/>
                            <field name="status"/>
                            <field name="posting_date"/>
                            <field name="posted_by"/>
                        </group>
                        <group>
                            <field name="bill_id"/>
                            <field name="payment_id"/>
                            <field name="account_move_id"/>
                            <field name="currency_id"/>
                            <field name="debit_total"/>
                            <field name="credit_total"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="message" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Raw Payload">
                        <field name="raw_payload" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_accounting_posting_log_search" model="ir.ui.view">
        <field name="name">hospital.accounting.posting.log.search</field>
        <field name="model">hospital.accounting.posting.log</field>
        <field name="arch" type="xml">
            <search string="Posting Logs">
                <field name="name"/>
                <field name="bill_id"/>
                <field name="payment_id"/>
                <field name="account_move_id"/>
                <filter name="success" string="Success" domain="[('status','=','success')]"/>
                <filter name="failed" string="Failed" domain="[('status','=','failed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_event" string="Event Type"
                            context="{'group_by': 'event_type'}"/>
                    <filter name="group_status" string="Status"
                            context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_accounting_posting_log" model="ir.actions.act_window">
        <field name="name">Posting Logs</field>
        <field name="res_model">hospital.accounting.posting.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_accounting_posting_log_search"/>
    </record>
</odoo>
