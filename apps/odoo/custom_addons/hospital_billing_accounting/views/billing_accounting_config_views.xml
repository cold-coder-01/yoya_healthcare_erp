<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_billing_accounting_config_list" model="ir.ui.view">
        <field name="name">hospital.billing.accounting.config.list</field>
        <field name="model">hospital.billing.accounting.config</field>
        <field name="arch" type="xml">
            <list string="Accounting Configurations">
                <field name="company_id"/>
                <field name="source_type"/>
                <field name="receivable_account_id"/>
                <field name="revenue_account_id"/>
                <field name="journal_id"/>
                <field name="invoice_journal_id"/>
                <field name="patient_advance_liability_account_id" optional="show"/>
                <field name="advance_configuration_complete" widget="boolean"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_billing_accounting_config_form" model="ir.ui.view">
        <field name="name">hospital.billing.accounting.config.form</field>
        <field name="model">hospital.billing.accounting.config</field>
        <field name="arch" type="xml">
            <form string="Accounting Configuration">
                <header>
                    <button name="action_validate_advance_configuration"
                            string="Validate Patient-advance Configuration"
                            type="object"
                            class="btn-primary"
                            groups="hospital_management.group_hospital_accountant,hospital_management.group_hospital_manager,hospital_management.group_hospital_system_administrator"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="source_type"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="journal_id"/>
                            <field name="invoice_journal_id"/>
                            <field name="payment_journal_id"/>
                        </group>
                    </group>
                    <group string="Bill Posting Accounts">
                        <field name="receivable_account_id"/>
                        <field name="revenue_account_id"/>
                    </group>
                    <group string="Payment Accounts (by method)">
                        <field name="cash_account_id"/>
                        <field name="bank_account_id"/>
                        <field name="mobile_money_account_id"/>
                    </group>
                    <group string="Inventory Valuation / COGS">
                        <field name="inventory_valuation_journal_id"/>
                        <field name="inventory_asset_account_id"/>
                        <field name="cogs_account_id"/>
                    </group>
                    <group string="Patient-advance Accounting Foundation">
                        <group>
                            <field name="patient_advance_liability_account_id"/>
                            <field name="patient_credit_liability_account_id"/>
                            <field name="advance_refund_clearing_account_id"/>
                        </group>
                        <group>
                            <field name="advance_receipt_journal_id"/>
                            <field name="advance_application_journal_id"/>
                            <field name="advance_refund_journal_id"/>
                            <field name="advance_configuration_complete" readonly="1"/>
                        </group>
                        <div class="alert alert-info" role="alert" colspan="2">
                            These mappings only prepare Tasks 32B-2/32B-3. Saving or
                            validating them does not create a receipt entry, invoice,
                            payment, reconciliation, refund or fiscal record.
                        </div>
                        <field name="advance_configuration_message" readonly="1"
                               nolabel="1" colspan="2"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_billing_accounting_config_search" model="ir.ui.view">
        <field name="name">hospital.billing.accounting.config.search</field>
        <field name="model">hospital.billing.accounting.config</field>
        <field name="arch" type="xml">
            <search string="Accounting Configurations">
                <field name="name"/>
                <field name="source_type"/>
                <field name="company_id"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_company" string="Company"
                            context="{'group_by': 'company_id'}"/>
                    <filter name="group_source" string="Source Type"
                            context="{'group_by': 'source_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_billing_accounting_config" model="ir.actions.act_window">
        <field name="name">Accounting Configurations</field>
        <field name="res_model">hospital.billing.accounting.config</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_billing_accounting_config_search"/>
    </record>
</odoo>
