<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hospital_invoice_batch_list" model="ir.ui.view">
        <field name="name">hospital.invoice.batch.list</field>
        <field name="model">hospital.invoice.batch</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0">
                <field name="name"/>
                <field name="request_token" optional="hide"/>
                <field name="encounter_id"/>
                <field name="patient_id"/>
                <field name="commercial_partner_id"/>
                <field name="invoice_id"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'completed'"
                    decoration-danger="state == 'failed'"
                    decoration-muted="state == 'cancelled'"/>
                <field name="retry_count"/>
                <field name="requested_by_id"/>
                <field name="requested_at"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_hospital_invoice_batch_form" model="ir.ui.view">
        <field name="name">hospital.invoice.batch.form</field>
        <field name="model">hospital.invoice.batch</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <header>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,processing,completed,failed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="request_token"/>
                            <field name="encounter_id"/>
                            <field name="billing_account_id"/>
                            <field name="patient_id"/>
                            <field name="commercial_partner_id"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="currency_id"/>
                            <field name="invoice_id"/>
                            <field name="requested_by_id"/>
                            <field name="requested_at"/>
                            <field name="retry_count"/>
                            <field name="completed_at"/>
                        </group>
                    </group>
                    <field name="error_summary" invisible="not error_summary"/>
                    <notebook>
                        <page string="Quantity Provenance">
                            <field name="allocation_ids">
                                <list>
                                    <field name="charge_id"/>
                                    <field name="allocation_type"/>
                                    <field name="quantity"/>
                                    <field name="move_id"/>
                                    <field name="move_line_id"/>
                                    <field name="state" widget="badge"/>
                                    <field name="source_model" optional="hide"/>
                                    <field name="source_res_id" optional="hide"/>
                                    <field name="source_line_id" optional="hide"/>
                                    <field name="idempotency_key" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_hospital_invoice_batch_search" model="ir.ui.view">
        <field name="name">hospital.invoice.batch.search</field>
        <field name="model">hospital.invoice.batch</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="request_token"/>
                <field name="encounter_id"/>
                <field name="patient_id"/>
                <field name="commercial_partner_id"/>
                <filter name="failed" string="Failed" domain="[('state','=','failed')]"/>
                <filter name="completed" string="Completed" domain="[('state','=','completed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="State" context="{'group_by':'state'}"/>
                    <filter name="group_company" string="Company" context="{'group_by':'company_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_hospital_invoice_batch" model="ir.actions.act_window">
        <field name="name">Invoice Batches</field>
        <field name="res_model">hospital.invoice.batch</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hospital_invoice_batch_search"/>
    </record>
</odoo>
