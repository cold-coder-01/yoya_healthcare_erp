<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Odoo ORs the rules of every group a user holds, so a group rule can
            only ever WIDEN access for a multi-role user. Restriction is applied
            only where the business rules demand it (doctor, nurse); every other
            role that already holds a read ACL gets an explicit unrestricted rule
            so it is deliberate rather than unruled by omission.

            group_hospital_manager implies receptionist + doctor + nurse, and
            system administrator implies manager, so both keep full access.
        -->

        <!-- ==========================================================
             hospital.patient.card.issue
             ========================================================== -->

        <record id="rule_card_issue_manager" model="ir.rule">
            <field name="name">Patient card issuance: all (manager / system administrator)</field>
            <field name="model_id" ref="model_hospital_patient_card_issue"/>
            <field name="groups" eval="[(4, ref('hospital_management.group_hospital_manager')), (4, ref('hospital_management.group_hospital_system_administrator'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_card_issue_front_office" model="ir.rule">
            <field name="name">Patient card issuance: all (receptionist / cashier)</field>
            <field name="model_id" ref="model_hospital_patient_card_issue"/>
            <field name="groups" eval="[(4, ref('hospital_management.group_hospital_receptionist')), (4, ref('hospital_billing.group_hospital_cashier'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_card_issue_clinical_read" model="ir.rule">
            <field name="name">Patient card issuance: read all (nurse / doctor / accountant)</field>
            <field name="model_id" ref="model_hospital_patient_card_issue"/>
            <field name="groups" eval="[(4, ref('hospital_management.group_hospital_nurse')), (4, ref('hospital_management.group_hospital_doctor')), (4, ref('hospital_management.group_hospital_accountant'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ==========================================================
             hospital.appointment
             ========================================================== -->

        <record id="rule_appointment_manager" model="ir.rule">
            <field name="name">Appointment: all (manager / system administrator)</field>
            <field name="model_id" ref="hospital_management.model_hospital_appointment"/>
            <field name="groups" eval="[(4, ref('hospital_management.group_hospital_manager')), (4, ref('hospital_management.group_hospital_system_administrator'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_appointment_front_office" model="ir.rule">
            <field name="name">Appointment: all (receptionist)</field>
            <field name="model_id" ref="hospital_management.model_hospital_appointment"/>
            <field name="groups" eval="[(4, ref('hospital_management.group_hospital_receptionist'))]"/>
            <!-- The front desk schedules the whole hospital; scoping it would
                 break the existing reception workflow. -->
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_appointment_cashier" model="ir.rule">
            <field name="name">Appointment: read all (cashier)</field>
            <field name="model_id" ref="hospital_management.model_hospital_appointment"/>
            <field name="groups" eval="[(4, ref('hospital_billing.group_hospital_cashier'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_appointment_dpo" model="ir.rule">
            <field name="name">Appointment: read all for oversight (data protection officer)</field>
            <field name="model_id" ref="hospital_management.model_hospital_appointment"/>
            <field name="groups" eval="[(4, ref('hospital_management.group_hospital_data_protection_officer'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_appointment_doctor" model="ir.rule">
            <field name="name">Appointment: my patients (doctor)</field>
            <field name="model_id" ref="hospital_management.model_hospital_appointment"/>
            <field name="groups" eval="[(4, ref('hospital_management.group_hospital_doctor'))]"/>
            <field name="domain_force">[('doctor_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_appointment_nurse" model="ir.rule">
            <field name="name">Appointment: my departments or my evaluations (nurse)</field>
            <field name="model_id" ref="hospital_management.model_hospital_appointment"/>
            <field name="groups" eval="[(4, ref('hospital_management.group_hospital_nurse'))]"/>
            <field name="domain_force">
                ['|',
                    ('department_id', 'in', user.yoya_permitted_department_ids.ids),
                    ('evaluation_ids.assigned_nurse_id', '=', user.id)
                ]
            </field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ==========================================================
             hospital.encounter
             ========================================================== -->

        <record id="rule_encounter_manager" model="ir.rule">
            <field name="name">Encounter: all (manager / system administrator)</field>
            <field name="model_id" ref="hospital_management.model_hospital_encounter"/>
            <field name="groups" eval="[(4, ref('hospital_management.group_hospital_manager')), (4, ref('hospital_management.group_hospital_system_administrator'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_encounter_front_office" model="ir.rule">
            <field name="name">Encounter: all (receptionist)</field>
            <field name="model_id" ref="hospital_management.model_hospital_encounter"/>
            <field name="groups" eval="[(4, ref('hospital_management.group_hospital_receptionist'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_encounter_service_desks" model="ir.rule">
            <field name="name">Encounter: read all (pharmacist / lab technician / accountant / cashier / DPO)</field>
            <field name="model_id" ref="hospital_management.model_hospital_encounter"/>
            <field name="groups" eval="[(4, ref('hospital_management.group_hospital_pharmacist')), (4, ref('hospital_management.group_hospital_lab_technician')), (4, ref('hospital_management.group_hospital_accountant')), (4, ref('hospital_billing.group_hospital_cashier')), (4, ref('hospital_management.group_hospital_data_protection_officer'))]"/>
            <!-- These desks work a cross-encounter queue of their own; scoping
                 them by department would break dispensing and lab workflows.
                 Unrestricted READ is a deliberate decision, not an omission. -->
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_encounter_doctor" model="ir.rule">
            <field name="name">Encounter: my patients (doctor)</field>
            <field name="model_id" ref="hospital_management.model_hospital_encounter"/>
            <field name="groups" eval="[(4, ref('hospital_management.group_hospital_doctor'))]"/>
            <field name="domain_force">
                ['|',
                    ('primary_doctor_id.user_id', '=', user.id),
                    ('appointment_id.doctor_id.user_id', '=', user.id)
                ]
            </field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ==========================================================
             Front Desk Nurse
             ==========================================================

             The entrance triages EVERY arrival, so these are unrestricted in
             the same way, and for the same reason, as the receptionist rules
             above. The department-scoped nurse rules stay exactly as they are;
             because Odoo ORs rules across a user's groups, a front desk nurse
             ends up with the union, which is the intended widening, and only
             for the three intake models named here. Nothing financial and
             nothing clinical beyond the nurse ACLs is widened.
        -->

        <record id="rule_appointment_front_desk_nurse" model="ir.rule">
            <field name="name">Appointment: all arrivals (front desk nurse)</field>
            <field name="model_id" ref="hospital_management.model_hospital_appointment"/>
            <field name="groups" eval="[(4, ref('group_hospital_front_desk_nurse'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_encounter_front_desk_nurse" model="ir.rule">
            <field name="name">Encounter: all arrivals (front desk nurse)</field>
            <field name="model_id" ref="hospital_management.model_hospital_encounter"/>
            <field name="groups" eval="[(4, ref('group_hospital_front_desk_nurse'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!--
            hospital.patient.evaluation for the Front Desk Nurse.

            WHY THIS EXISTS. Front Desk Nurse implies Hospital Nurse, so without
            this rule the desk fell under rule_patient_evaluation_nurse
            (yoya_clinical_bridge), whose domain is:

                assigned_nurse_id = me
                OR (assigned_nurse_id = False
                    AND appointment_id != False
                    AND appointment_id.department_id in my permitted departments)

            assigned_nurse_id carries default=lambda self: self.env.user, so the
            moment nurse A starts a triage the record is stamped with A. The
            second branch requires assigned_nurse_id to be EMPTY, so it can
            never match for nurse B afterwards, and no department configuration
            rescues it. At a desk worked in shifts that is wrong twice over:

              1. nurse B cannot read or continue nurse A's triage;
              2. worse, it is SILENT. appointment.front_desk_stage is a
                 non-stored compute (compute_sudo defaults to False for those)
                 that derives the stage from evaluation_ids, and Odoo FILTERS an
                 unreadable x2many instead of raising. Nurse B's worklist
                 therefore renders a patient A has already triaged as 'intake',
                 with the counters to match.

            Scoped to appointment-linked evaluations, deliberately: an
            evaluation with no appointment is a purely clinical artefact (ward
            nursing, the future Nurses workspace) and is none of the entrance's
            business. Same boundary the receptionist rule draws, with the
            write/create the desk actually needs.

            No ACL row is added: Front Desk Nurse inherits 1,1,1,0 on this model
            from Hospital Nurse, so unlink stays impossible at the ACL layer as
            well as here.

            Because Odoo ORs group rules, this widens ONLY holders of
            group_hospital_front_desk_nurse. rule_patient_evaluation_nurse is
            left exactly as it is, so a plain Hospital Nurse is unaffected.
        -->

        <record id="rule_patient_evaluation_front_desk_nurse" model="ir.rule">
            <field name="name">Patient Evaluation: all appointment-linked arrivals (front desk nurse)</field>
            <field name="model_id" ref="hospital_management.model_hospital_patient_evaluation"/>
            <field name="groups" eval="[(4, ref('group_hospital_front_desk_nurse'))]"/>
            <field name="domain_force">[('appointment_id', '!=', False)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_card_issue_front_desk_nurse" model="ir.rule">
            <field name="name">Patient card issuance: all (front desk nurse)</field>
            <field name="model_id" ref="model_hospital_patient_card_issue"/>
            <field name="groups" eval="[(4, ref('group_hospital_front_desk_nurse'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_encounter_nurse" model="ir.rule">
            <field name="name">Encounter: my departments or my evaluations (nurse)</field>
            <field name="model_id" ref="hospital_management.model_hospital_encounter"/>
            <field name="groups" eval="[(4, ref('hospital_management.group_hospital_nurse'))]"/>
            <field name="domain_force">
                ['|',
                    ('department_id', 'in', user.yoya_permitted_department_ids.ids),
                    ('appointment_id.evaluation_ids.assigned_nurse_id', '=', user.id)
                ]
            </field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
