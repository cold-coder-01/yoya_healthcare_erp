<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hospital_patient_card_issue_list" model="ir.ui.view">
        <field name="name">hospital.patient.card.issue.list</field>
        <field name="model">hospital.patient.card.issue</field>
        <field name="arch" type="xml">
            <list string="Patient Card Issuances"
                  decoration-muted="state == 'cancelled'"
                  decoration-warning="state == 'deferred'"
                  decoration-success="state == 'issued'">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="issue_reason"/>
                <field name="card_number" optional="show"/>
                <field name="encounter_id" optional="hide"/>
                <field name="service_id" optional="hide"/>
                <field name="charge_line_id" optional="show"/>
                <field name="charge_payment_state" optional="show"/>
                <field name="registered_by_id" optional="hide"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_patient_card_issue_form" model="ir.ui.view">
        <field name="name">hospital.patient.card.issue.form</field>
        <field name="model">hospital.patient.card.issue</field>
        <field name="arch" type="xml">
            <form string="Patient Card Issuance">
                <header>
                    <button name="action_create_charge" string="Raise Card Charge" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_mark_paid" string="Verify Payment" type="object"
                            class="btn-primary" invisible="state != 'charged'"/>
                    <button name="action_issue" string="Issue Card" type="object"
                            class="btn-primary" invisible="state not in ('paid', 'waived', 'deferred')"/>
                    <button name="action_waive" string="Waive Fee" type="object"
                            confirm="Waiving forgoes the card fee entirely and cancels any raised charge. Continue?"
                            invisible="state not in ('draft', 'charged')"
                            groups="hospital_management.group_hospital_manager"/>
                    <button name="action_defer" string="Defer (Emergency)" type="object"
                            confirm="The fee stays outstanding and visible. Continue?"
                            invisible="state not in ('draft', 'charged')"
                            groups="yoya_reception_bridge.group_hospital_emergency_authorizer,hospital_management.group_hospital_manager"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('issued', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,charged,paid,issued"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Issuance">
                            <field name="patient_id" readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="issue_reason" readonly="state != 'draft'"/>
                            <field name="encounter_id" readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="card_number"/>
                        </group>
                        <group string="Billing">
                            <field name="service_id" readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="charge_line_id"/>
                            <field name="charge_amount" widget="monetary"/>
                            <field name="charge_payment_state"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group string="Audit Trail">
                            <field name="registered_by_id"/>
                            <field name="issued_by_id"/>
                            <field name="issued_at"/>
                            <field name="waived_by_id"/>
                        </group>
                        <group string="Exceptions">
                            <field name="waiver_reason"
                                   placeholder="Required when waiving the fee..."/>
                            <field name="deferred_until_encounter_id" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hospital_patient_card_issue_search" model="ir.ui.view">
        <field name="name">hospital.patient.card.issue.search</field>
        <field name="model">hospital.patient.card.issue</field>
        <field name="arch" type="xml">
            <!--
                Lookup and troubleshooting only. The daily "who still owes a card
                fee" queue belongs in the Next.js receptionist page, not here, so
                no operational status filters are provided.
            -->
            <search string="Patient Card Issuances">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="card_number"/>
                <field name="encounter_id"/>
                <field name="charge_line_id"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hospital_patient_card_issue" model="ir.actions.act_window">
        <field name="name">Patient Card Issuances</field>
        <field name="res_model">hospital.patient.card.issue</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hospital_patient_card_issue_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Track patient card issuance, replacement, waiver and deferral.
            </p>
        </field>
    </record>

</odoo>
