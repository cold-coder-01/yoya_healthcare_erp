<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hospital_emergency_danger_sign_list" model="ir.ui.view">
        <field name="name">hospital.emergency.danger.sign.list</field>
        <field name="model">hospital.emergency.danger.sign</field>
        <field name="arch" type="xml">
            <list string="Emergency Danger Signs" editable="bottom"
                  decoration-danger="severity == 'critical'"
                  decoration-warning="severity == 'high'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="severity"/>
                <field name="requires_immediate_triage"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_emergency_danger_sign_form" model="ir.ui.view">
        <field name="name">hospital.emergency.danger.sign.form</field>
        <field name="model">hospital.emergency.danger.sign</field>
        <field name="arch" type="xml">
            <form string="Emergency Danger Sign">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Danger sign"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="severity"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="requires_immediate_triage"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hospital_emergency_danger_sign" model="ir.actions.act_window">
        <field name="name">Emergency Danger Signs</field>
        <field name="res_model">hospital.emergency.danger.sign</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
