<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="report_hospital_nursing_summary" model="ir.actions.report">
        <field name="name">Nursing Summary</field>
        <field name="model">hospital.admission</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hospital_nursing.report_nursing_summary_template</field>
        <field name="report_file">hospital_nursing.report_nursing_summary_template</field>
        <field name="print_report_name">'Nursing Summary - ' + object.name</field>
        <field name="binding_model_id" model="ir.model" search="[('model', '=', 'hospital.admission')]"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
