<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sequence_hospital_nursing_round" model="ir.sequence">
        <field name="name">Nursing Round Sequence</field>
        <field name="code">hospital.nursing.round.sequence</field>
