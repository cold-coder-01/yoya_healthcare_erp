<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════
         CARE PLAN — LIST VIEW
    ═══════════════════════════════════════════════════════════ -->

    <record id="view_hospital_nursing_care_plan_list" model="ir.ui.view">
        <field name="name">hospital.nursing.care.plan.list</field>
        <field name="model">hospital.nursing.care.plan</field>
        <field name="arch" type="xml">
            <list string="Care Plans"
                decoration-success="state == 'completed'"
                decoration-info="state == 'active'"
                decoration-muted="state == 'cancelled'"
                decoration-warning="state == 'draft'">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="admission_id"/>
                <field name="plan_date"/>
                <field name="nurse_id"/>
                <field name="physician_id"/>
                <field name="priority"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         CARE PLAN — FORM VIEW
    ═══════════════════════════════════════════════════════════ -->

    <record id="view_hospital_nursing_care_plan_form" model="ir.ui.view">
        <field name="name">hospital.nursing.care.plan.form</field>
        <field name="model">hospital.nursing.care.plan</field>
        <field name="arch" type="xml">
            <form string="Nursing Care Plan">
                <header>
                    <button
                        name="action_activate"
                        string="Activate"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"/>
                    <button
                        name="action_complete"
                        string="Complete"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'active'"/>
                    <button
                        name="action_cancel"
                        string="Cancel"
                        type="object"
                        invisible="state not in ('draft', 'active')"/>
                    <button
                        name="action_reset_to_draft"
                        string="Reset to Draft"
                        type="object"
                        invisible="state != 'cancelled'"
                        groups="hospital_management.group_hospital_manager,hospital_management.group_hospital_system_administrator"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,completed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group string="Patient / Admission">
                        <group>
                            <field name="patient_id" readonly="state not in ('draft',)"/>
                            <field name="admission_id"
                                domain="[('patient_id', '=', patient_id)]"
                                readonly="state not in ('draft',)"/>
                            <field name="nurse_id" readonly="state in ['completed', 'cancelled']"/>
                            <field name="physician_id" readonly="state in ['completed', 'cancelled']"/>
                        </group>
                        <group>
                            <field name="plan_date" readonly="state in ['completed', 'cancelled']"/>
                            <field name="priority" readonly="state in ['completed', 'cancelled']"/>
                            <field name="completed_date" readonly="1" invisible="state != 'completed'"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>

                    <group string="Nursing Diagnosis">
                        <field name="nursing_diagnosis" nolabel="1" placeholder="Enter nursing diagnosis..." readonly="state in ['completed', 'cancelled']"/>
                    </group>

                    <group string="Goals">
                        <field name="goals" nolabel="1" placeholder="Enter patient care goals..." readonly="state in ['completed', 'cancelled']"/>
                    </group>

                    <group string="Interventions">
                        <field name="interventions" nolabel="1" placeholder="Enter nursing interventions..." readonly="state in ['completed', 'cancelled']"/>
                    </group>

                    <group string="Evaluation">
                        <field name="evaluation" nolabel="1" placeholder="Enter evaluation findings..." readonly="state in ['completed', 'cancelled']"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         CARE PLAN — SEARCH VIEW
    ═══════════════════════════════════════════════════════════ -->

    <record id="view_hospital_nursing_care_plan_search" model="ir.ui.view">
        <field name="name">hospital.nursing.care.plan.search</field>
        <field name="model">hospital.nursing.care.plan</field>
        <field name="arch" type="xml">
            <search string="Care Plans">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="admission_id"/>
                <field name="nurse_id"/>
                <field name="physician_id"/>
                <filter string="Active" name="active_plans" domain="[('state', '=', 'active')]"/>
                <filter string="High Priority" name="high_priority"
                    domain="[('priority', 'in', ('high', 'urgent')), ('state', '=', 'active')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Patient" name="group_patient" context="{'group_by': 'patient_id'}"/>
                    <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'plan_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         CARE PLAN — ACTION
    ═══════════════════════════════════════════════════════════ -->

    <record id="action_hospital_nursing_care_plan" model="ir.actions.act_window">
        <field name="name">Care Plans</field>
        <field name="res_model">hospital.nursing.care.plan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hospital_nursing_care_plan_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No care plans found.
            </p>
            <p>Create a nursing care plan to document diagnosis, goals, and interventions.</p>
        </field>
    </record>

</odoo>
