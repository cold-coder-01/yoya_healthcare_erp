<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════
         WARD VIEWS
    ═══════════════════════════════════════════════════════════ -->

    <record id="view_hospital_ward_list" model="ir.ui.view">
        <field name="name">hospital.ward.list</field>
        <field name="model">hospital.ward</field>
        <field name="arch" type="xml">
            <list string="Wards">
                <field name="code"/>
                <field name="name"/>
                <field name="ward_type"/>
                <field name="floor"/>
                <field name="department_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_ward_form" model="ir.ui.view">
        <field name="name">hospital.ward.form</field>
        <field name="model">hospital.ward</field>
        <field name="arch" type="xml">
            <form string="Ward">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Ward Information">
                            <field name="code"/>
                            <field name="ward_type"/>
                            <field name="floor"/>
                            <field name="department_id"/>
                            <field name="active"/>
                        </group>
                        <group string="Description">
                            <field name="description" nolabel="1"/>
                        </group>
                    </group>
                    <group string="Pricing">
                        <group>
                            <field name="currency_id"/>
                            <field name="admission_fee"/>
                            <field name="daily_ward_rate"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hospital_ward_search" model="ir.ui.view">
        <field name="name">hospital.ward.search</field>
        <field name="model">hospital.ward</field>
        <field name="arch" type="xml">
            <search string="Search Wards">
                <field name="name"/>
                <field name="code"/>
                <field name="department_id"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Ward Type" name="group_ward_type" context="{'group_by': 'ward_type'}"/>
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hospital_ward" model="ir.actions.act_window">
        <field name="name">Wards</field>
        <field name="res_model">hospital.ward</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hospital_ward_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         ROOM VIEWS
    ═══════════════════════════════════════════════════════════ -->

    <record id="view_hospital_room_list" model="ir.ui.view">
        <field name="name">hospital.room.list</field>
        <field name="model">hospital.room</field>
        <field name="arch" type="xml">
            <list string="Rooms">
                <field name="code"/>
                <field name="name"/>
                <field name="ward_id"/>
                <field name="room_type"/>
                <field name="floor"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_room_form" model="ir.ui.view">
        <field name="name">hospital.room.form</field>
        <field name="model">hospital.room</field>
        <field name="arch" type="xml">
            <form string="Room">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Room Information">
                            <field name="code"/>
                            <field name="ward_id"/>
                            <field name="room_type"/>
                            <field name="floor"/>
                            <field name="active"/>
                        </group>
                        <group string="Description">
                            <field name="description" nolabel="1"/>
                        </group>
                    </group>
                    <group string="Pricing">
                        <group>
                            <field name="currency_id"/>
                            <field name="daily_room_rate"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hospital_room_search" model="ir.ui.view">
        <field name="name">hospital.room.search</field>
        <field name="model">hospital.room</field>
        <field name="arch" type="xml">
            <search string="Search Rooms">
                <field name="name"/>
                <field name="code"/>
                <field name="ward_id"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Ward" name="group_ward" context="{'group_by': 'ward_id'}"/>
                    <filter string="Room Type" name="group_room_type" context="{'group_by': 'room_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hospital_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">hospital.room</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hospital_room_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         BED VIEWS
    ═══════════════════════════════════════════════════════════ -->

    <record id="view_hospital_bed_list" model="ir.ui.view">
        <field name="name">hospital.bed.list</field>
        <field name="model">hospital.bed</field>
        <field name="arch" type="xml">
            <list string="Beds"
                decoration-success="state == 'available'"
                decoration-danger="state == 'occupied' or state == 'blocked'"
                decoration-info="state == 'cleaning'"
                decoration-warning="state == 'maintenance'">
                <field name="code"/>
                <field name="name"/>
                <field name="ward_id"/>
                <field name="room_id"/>
                <field name="bed_type"/>
                <field name="state"/>
                <field name="current_admission_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_bed_form" model="ir.ui.view">
        <field name="name">hospital.bed.form</field>
        <field name="model">hospital.bed</field>
        <field name="arch" type="xml">
            <form string="Bed">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Bed Information">
                            <field name="code"/>
                            <field name="room_id"/>
                            <field name="ward_id" readonly="1"/>
                            <field name="bed_type"/>
                            <field name="active"/>
                        </group>
                        <group string="Status">
                            <field name="state"/>
                            <field name="current_admission_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Pricing">
                        <group>
                            <field name="currency_id"/>
                            <field name="daily_bed_rate"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hospital_bed_search" model="ir.ui.view">
        <field name="name">hospital.bed.search</field>
        <field name="model">hospital.bed</field>
        <field name="arch" type="xml">
            <search string="Search Beds">
                <field name="name"/>
                <field name="code"/>
                <field name="ward_id"/>
                <field name="room_id"/>
                <filter string="Available" name="available" domain="[('state', '=', 'available')]"/>
                <filter string="Occupied" name="occupied" domain="[('state', '=', 'occupied')]"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Ward" name="group_ward" context="{'group_by': 'ward_id'}"/>
                    <filter string="Room" name="group_room" context="{'group_by': 'room_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Bed Type" name="group_bed_type" context="{'group_by': 'bed_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hospital_bed" model="ir.actions.act_window">
        <field name="name">Beds</field>
        <field name="res_model">hospital.bed</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hospital_bed_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>

</odoo>
