<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_admission_summary">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>
                            .hospital-report-title {
                                color: #006A4F;
                                font-size: 22px;
                                font-weight: 700;
                                margin-bottom: 4px;
                            }
                            .hospital-section-title {
                                color: #006A4F;
                                font-size: 14px;
                                font-weight: 700;
                                border-bottom: 1px solid #CCCCCC;
                                padding-bottom: 4px;
                                margin: 16px 0 8px;
                            }
                            .hospital-report-table {
                                width: 100%;
                                border-collapse: collapse;
                                margin-bottom: 10px;
                            }
                            .hospital-report-table th {
                                background: #F3F8F6;
                                color: #333333;
                                font-weight: 700;
                            }
                            .hospital-report-table th,
                            .hospital-report-table td {
                                border: 1px solid #DDDDDD;
                                padding: 5px 8px;
                                font-size: 11px;
                                vertical-align: top;
                            }
                            .hospital-info-table {
                                width: 100%;
                                border-collapse: collapse;
                                margin-bottom: 10px;
                            }
                            .hospital-info-table td {
                                padding: 4px 8px;
                                font-size: 11px;
                                vertical-align: top;
                                border: 1px solid #EEEEEE;
                            }
                            .hospital-info-table td:first-child {
                                width: 26%;
                                color: #555555;
                                font-weight: 700;
                                background: #F9F9F9;
                            }
                            .hospital-empty-note {
                                color: #888888;
                                font-style: italic;
                                font-size: 11px;
                                padding: 6px 0;
                            }
                            .hospital-report-meta {
                                color: #555555;
                                font-size: 11px;
                                margin-bottom: 14px;
                            }
                        </style>

                        <t t-set="report_title" t-value="'Admission Summary'"/>
                        <t t-set="report_ref_label" t-value="'Admission Ref'"/>
                        <t t-set="report_ref" t-value="doc.name"/>
                        <t t-set="report_date_label" t-value="'Admission Date'"/>
                        <t t-set="report_date" t-value="doc.admission_date and doc.admission_date.strftime('%Y-%m-%d %H:%M') or ''"/>
                        <t t-call="hospital_management.hospital_report_header"/>

                        <div class="hospital-report-meta">
                            <strong>Print Date:</strong>
                            <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
                        </div>

                        <!-- Patient & Clinical Information -->
                        <div class="hospital-section-title">Patient &amp; Clinical Information</div>
                        <table class="hospital-info-table">
                            <tr>
                                <td>Patient</td>
                                <td><span t-field="doc.patient_id"/></td>
                                <td>Physician</td>
                                <td><span t-field="doc.physician_id"/></td>
                            </tr>
                            <tr>
                                <td>Appointment</td>
                                <td><span t-field="doc.appointment_id"/></td>
                                <td>Diagnosis</td>
                                <td><span t-field="doc.diagnosis_id"/></td>
                            </tr>
                        </table>

                        <!-- Admission Details -->
                        <div class="hospital-section-title">Admission Details</div>
                        <table class="hospital-info-table">
                            <tr>
                                <td>Admission Reference</td>
                                <td><span t-field="doc.name"/></td>
                                <td>Status</td>
                                <td><span t-field="doc.state"/></td>
                            </tr>
                            <tr>
                                <td>Admission Date</td>
                                <td><span t-field="doc.admission_date"/></td>
                                <td>Expected Discharge</td>
                                <td><span t-field="doc.expected_discharge_date"/></td>
                            </tr>
                            <t t-if="doc.discharge_date">
                                <tr>
                                    <td>Discharge Date</td>
                                    <td colspan="3"><span t-field="doc.discharge_date"/></td>
                                </tr>
                            </t>
                        </table>

                        <!-- Bed Assignment -->
                        <div class="hospital-section-title">Bed Assignment</div>
                        <table class="hospital-info-table">
                            <tr>
                                <td>Ward</td>
                                <td><span t-field="doc.ward_id"/></td>
                                <td>Room</td>
                                <td><span t-field="doc.room_id"/></td>
                            </tr>
                            <tr>
                                <td>Bed</td>
                                <td colspan="3"><span t-field="doc.bed_id"/></td>
                            </tr>
                        </table>

                        <!-- Admission Reason -->
                        <t t-if="doc.admission_reason">
                            <div class="hospital-section-title">Admission Reason</div>
                            <p style="font-size: 11px; margin: 0 0 10px;">
                                <span t-field="doc.admission_reason"/>
                            </p>
                        </t>

                        <!-- Discharge Summary -->
                        <t t-if="doc.discharge_summary">
                            <div class="hospital-section-title">Discharge Summary</div>
                            <p style="font-size: 11px; margin: 0 0 10px;">
                                <span t-field="doc.discharge_summary"/>
                            </p>
                        </t>

                        <!-- Billing Summary -->
                        <div class="hospital-section-title">Billing Summary</div>
                        <table class="hospital-info-table">
                            <tr>
                                <td>Billing Status</td>
                                <td><span t-field="doc.billing_state"/></td>
                                <td>Bill Reference</td>
                                <td>
                                    <t t-if="doc.bill_id">
                                        <span t-field="doc.bill_id"/>
                                    </t>
                                    <t t-else="">
                                        <span>Not billed</span>
                                    </t>
                                </td>
                            </tr>
                            <tr>
                                <td>Stay Days</td>
                                <td><span t-field="doc.stay_days"/></td>
                                <td>Daily Rate</td>
                                <td><span t-field="doc.daily_rate_amount"/></td>
                            </tr>
                            <tr>
                                <td>Admission Fee</td>
                                <td><span t-field="doc.admission_fee_amount"/></td>
                                <td>Bed Charge</td>
                                <td><span t-field="doc.bed_charge_amount"/></td>
                            </tr>
                            <tr>
                                <td>Total Admission Charge</td>
                                <td colspan="3"><span t-field="doc.total_admission_charge"/></td>
                            </tr>
                        </table>

                        <!-- Transfer History -->
                        <div class="hospital-section-title">Transfer History</div>
                        <t t-if="doc.transfer_ids">
                            <table class="hospital-report-table">
                                <thead>
                                    <tr>
                                        <th>Transfer Date</th>
                                        <th>From Ward</th>
                                        <th>From Room</th>
                                        <th>From Bed</th>
                                        <th>To Ward</th>
                                        <th>To Room</th>
                                        <th>To Bed</th>
                                        <th>Transferred By</th>
                                        <th>Reason</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.transfer_ids" t-as="transfer">
                                        <tr>
                                            <td><span t-field="transfer.transfer_date"/></td>
                                            <td><span t-field="transfer.from_ward_id"/></td>
                                            <td><span t-field="transfer.from_room_id"/></td>
                                            <td><span t-field="transfer.from_bed_id"/></td>
                                            <td><span t-field="transfer.to_ward_id"/></td>
                                            <td><span t-field="transfer.to_room_id"/></td>
                                            <td><span t-field="transfer.to_bed_id"/></td>
                                            <td><span t-field="transfer.transferred_by"/></td>
                                            <td><span t-field="transfer.reason"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <p class="hospital-empty-note">No transfers recorded for this admission.</p>
                        </t>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
