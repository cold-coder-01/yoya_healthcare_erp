<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Test -> billing service mapping -->
    <record id="view_hospital_laboratory_test_form_billing" model="ir.ui.view">
        <field name="name">hospital.laboratory.test.form.billing</field>
        <field name="model">hospital.laboratory.test</field>
        <field name="inherit_id" ref="hospital_management.view_hospital_laboratory_test_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Billing" name="lab_billing">
                    <field name="billing_service_id"
                        options="{'no_create': True}"
                        help="Required before this test can be charged."/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_hospital_laboratory_test_list_billing" model="ir.ui.view">
        <field name="name">hospital.laboratory.test.list.billing</field>
        <field name="model">hospital.laboratory.test</field>
        <field name="inherit_id" ref="hospital_management.view_hospital_laboratory_test_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="billing_service_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Request: clearance banner, encounter link, charges -->
    <record id="view_hospital_laboratory_request_form_billing" model="ir.ui.view">
        <field name="name">hospital.laboratory.request.form.billing</field>
        <field name="model">hospital.laboratory.request</field>
        <field name="inherit_id" ref="hospital_management.view_hospital_laboratory_request_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning" role="alert" invisible="not billing_blocked">
                    <i class="fa fa-lock"/>
                    <strong> Financial clearance required before sample collection. </strong>
                    <field name="billing_clearance_message" readonly="1" nolabel="1"
                        class="oe_inline"/>
                </div>
            </xpath>

            <!-- The ordered tests are frozen once the request is confirmed: the charges
                 were raised from exactly this set. Mirrors the model-level lock. -->
            <xpath expr="//field[@name='line_ids']" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>

            <xpath expr="//page[@name='requested_tests']" position="inside">
                <div class="alert alert-info mt-2" role="alert"
                    invisible="state == 'draft'">
                    <i class="fa fa-lock"/>
                    The requested tests are locked because this request has been confirmed
                    and its charges have been raised. To order a different set of tests,
                    cancel this request and raise a new one.
                </div>
            </xpath>

            <!-- Charges smart button. Counts every charge raised from this request,
                 including archived/cancelled ones (active_test=False), so the figure
                 is the request's real financial history. Hidden when there are none.
                 Same group restriction as before: cash stays out of clinical hands. -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_charges" type="object"
                    class="oe_stat_button" icon="fa-money"
                    invisible="not id or charge_count == 0"
                    groups="hospital_management.group_hospital_receptionist,hospital_management.group_hospital_accountant,hospital_management.group_hospital_manager,hospital_management.group_hospital_system_administrator">
                    <field name="charge_count" widget="statinfo" string="Charges"
                        readonly="1"/>
                </button>
                <!-- Receipts reached through charge ALLOCATIONS: one combined receipt
                     paying every test shows once, not once per allocated charge. -->
                <button name="action_view_receipts" type="object"
                    class="oe_stat_button" icon="fa-file-text-o"
                    invisible="not id or receipt_count == 0"
                    groups="hospital_management.group_hospital_receptionist,hospital_management.group_hospital_accountant,hospital_management.group_hospital_manager,hospital_management.group_hospital_system_administrator">
                    <field name="receipt_count" widget="statinfo" string="Receipts"
                        readonly="1"/>
                </button>
            </xpath>

            <xpath expr="//header" position="inside">
                <!-- ONE payment event settling every unpaid test on the request. -->
                <button name="action_record_payment" type="object"
                    string="Record Payment / Advance" class="btn-primary"
                    invisible="charge_count == 0 or state == 'cancelled'"
                    groups="hospital_management.group_hospital_receptionist,hospital_management.group_hospital_accountant,hospital_management.group_hospital_manager,hospital_management.group_hospital_system_administrator"/>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <group string="Billing" name="lab_billing">
                    <field name="encounter_id" readonly="1"/>
                    <field name="billing_blocked" invisible="1"/>
                    <field name="receipt_count" invisible="1"/>
                    <button name="action_establish_standalone_encounter"
                        type="object" string="Establish Standalone Encounter"
                        class="btn-link"
                        invisible="encounter_id or appointment_id or state == 'cancelled'"
                        help="Only for a genuine walk-in request with no originating appointment."/>
                </group>
            </xpath>

        </field>
    </record>

</odoo>
