<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_pharmacy_dispense">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>
                            .hospital-report-title {
                                color: #006A4F;
                                font-size: 22px;
                                font-weight: 700;
                                margin-bottom: 4px;
                            }
                            .hospital-section-title {
                                color: #006A4F;
                                font-size: 14px;
                                font-weight: 700;
                                margin: 12px 0 6px;
                            }
                            .hospital-report-table {
                                width: 100%;
                                border-collapse: collapse;
                                margin-bottom: 10px;
                            }
                            .hospital-report-table th {
                                background: #F3F8F6;
                                color: #333333;
                                font-weight: 700;
                            }
                            .hospital-report-table th,
                            .hospital-report-table td {
                                border: 1px solid #DDDDDD;
                                padding: 5px;
                                font-size: 11px;
                                vertical-align: top;
                            }
                            .hospital-info-table td:first-child,
                            .hospital-info-table td:nth-child(3) {
                                width: 18%;
                                color: #555555;
                                font-weight: 700;
                            }
                            .hospital-empty-note {
                                color: #666666;
                                font-style: italic;
                                margin: 6px 0 10px;
                            }
                            .hospital-footer-note {
                                color: #555555;
                                font-size: 11px;
                                margin-top: 16px;
                            }
                            .priority-urgent {
                                color: #E65100;
                                font-weight: 700;
                            }
                            .priority-emergency {
                                color: #B71C1C;
                                font-weight: 700;
                            }
                        </style>

                        <t t-set="report_title" t-value="'Pharmacy Dispense Slip'"/>
                        <t t-set="report_ref_label" t-value="'Dispense Ref'"/>
                        <t t-set="report_ref" t-value="doc.name"/>
                        <t t-set="report_date_label" t-value="'Dispense Date'"/>
                        <t t-set="report_date" t-value="doc.dispense_date"/>
                        <t t-call="hospital_management.hospital_report_header"/>

                        <!-- Dispense Information -->
                        <table class="hospital-report-table hospital-info-table">
                            <tbody>
                                <tr>
                                    <td>Dispense Reference</td>
                                    <td><span t-field="doc.name"/></td>
                                    <td>Dispense Date</td>
                                    <td><span t-field="doc.dispense_date"/></td>
                                </tr>
                                <tr>
                                    <td>Patient</td>
                                    <td>
                                        <span t-field="doc.patient_id.name"/>
                                        <t t-if="doc.patient_id.identification_code">
                                            (<span t-field="doc.patient_id.identification_code"/>)
                                        </t>
                                    </td>
                                    <td>Priority</td>
                                    <td>
                                        <t t-if="doc.priority == 'emergency'">
                                            <span class="priority-emergency" t-field="doc.priority"/>
                                        </t>
                                        <t t-if="doc.priority == 'urgent'">
                                            <span class="priority-urgent" t-field="doc.priority"/>
                                        </t>
                                        <t t-if="doc.priority == 'routine'">
                                            <span t-field="doc.priority"/>
                                        </t>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Physician</td>
                                    <td><span t-field="doc.physician_id.name"/></td>
                                    <td>Pharmacist</td>
                                    <td><span t-field="doc.pharmacist_id.name"/></td>
                                </tr>
                                <t t-if="doc.prescription_id">
                                    <tr>
                                        <td>Prescription Ref</td>
                                        <td><span t-field="doc.prescription_id.name"/></td>
                                        <td>Status</td>
                                        <td><span t-field="doc.state"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Medicine Lines -->
                        <p class="hospital-section-title">Dispensed Medicines</p>
                        <t t-if="doc.line_ids">
                            <table class="hospital-report-table">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Medicine</th>
                                        <th>Dosage</th>
                                        <th>Frequency</th>
                                        <th>Duration</th>
                                        <th>Route</th>
                                        <th>Prescribed Qty</th>
                                        <th>Dispensed Qty</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.line_ids" t-as="line">
                                        <tr>
                                            <td><span t-out="line_index + 1"/></td>
                                            <td><span t-field="line.medicine_id.display_name"/></td>
                                            <td><span t-field="line.dosage"/></td>
                                            <td><span t-field="line.frequency"/></td>
                                            <td><span t-field="line.duration"/></td>
                                            <td><span t-field="line.route"/></td>
                                            <td><span t-field="line.prescribed_quantity"/></td>
                                            <td><span t-field="line.dispensed_quantity"/></td>
                                        </tr>
                                        <t t-if="line.instruction">
                                            <tr>
                                                <td></td>
                                                <td colspan="7" style="color: #555555; font-style: italic;">
                                                    Instructions: <span t-field="line.instruction"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-if="not doc.line_ids">
                            <p class="hospital-empty-note">No medicine lines recorded.</p>
                        </t>

                        <!-- Notes -->
                        <t t-if="doc.notes">
                            <p class="hospital-section-title">Notes</p>
                            <p style="font-size: 11px; color: #333333;">
                                <span t-field="doc.notes"/>
                            </p>
                        </t>

                        <!-- Footer -->
                        <div class="hospital-footer-note" style="margin-top: 24px; border-top: 1px solid #DDDDDD; padding-top: 10px;">
                            <table style="width: 100%;">
                                <tr>
                                    <td style="width: 50%;">
                                        <p style="margin: 0;">Dispensed by: <span t-field="doc.pharmacist_id.name"/></p>
                                        <p style="margin: 24px 0 0 0; border-top: 1px solid #333; width: 200px;">Pharmacist Signature</p>
                                    </td>
                                    <td style="width: 50%; text-align: right;">
                                        <p style="margin: 0;">Received by: ___________________________</p>
                                        <p style="margin: 24px 0 0 0;">Patient / Guardian Signature</p>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
