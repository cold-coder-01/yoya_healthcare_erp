<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="menu_hospital_pharmacy_root" model="ir.ui.menu">
        <field name="name">Pharmacy</field>
        <field name="sequence">37</field>
        <field name="parent_id" eval="False"/>
        <field name="web_icon">hospital_management,static/description/hospital.svg</field>
        <field name="groups_id" eval="[(6, 0, [
            ref('hospital_management.group_hospital_system_administrator'),
            ref('hospital_management.group_hospital_manager'),
            ref('hospital_management.group_hospital_receptionist'),
            ref('hospital_management.group_hospital_doctor'),
            ref('hospital_management.group_hospital_nurse'),
            ref('hospital_management.group_hospital_pharmacist'),
            ref('hospital_management.group_hospital_accountant'),
            ref('hospital_management.group_hospital_data_protection_officer'),
            ref('base.group_system')
        ])]"/>
    </record>

    <record id="menu_hospital_pharmacy_dispenses" model="ir.ui.menu">
        <field name="name">Pharmacy Dispenses</field>
        <field name="parent_id" ref="menu_hospital_pharmacy_root"/>
        <field name="action" eval="'ir.actions.act_window,%d' % ref('action_hospital_pharmacy_dispense')"/>
        <field name="sequence">10</field>
        <field name="web_icon" eval="False"/>
    </record>

    <record id="menu_hospital_pharmacy_medicines" model="ir.ui.menu">
        <field name="name">Medicines</field>
        <field name="parent_id" ref="menu_hospital_pharmacy_root"/>
        <field name="action" eval="'ir.actions.act_window,%d' % ref('action_hospital_pharmacy_medicine')"/>
        <field name="sequence">20</field>
        <field name="web_icon" eval="False"/>
    </record>

    <record id="menu_hospital_pharmacy_configuration" model="ir.ui.menu">
        <field name="name">Configuration</field>
        <field name="parent_id" ref="menu_hospital_pharmacy_root"/>
        <field name="sequence">90</field>
        <field name="web_icon" eval="False"/>
        <field name="groups_id" eval="[(6, 0, [
            ref('hospital_management.group_hospital_system_administrator'),
            ref('hospital_management.group_hospital_manager'),
            ref('hospital_management.group_hospital_pharmacist'),
            ref('base.group_system')
        ])]"/>
    </record>

    <record id="menu_hospital_pharmacy_configuration_medicines" model="ir.ui.menu">
        <field name="name">Medicines</field>
        <field name="parent_id" ref="menu_hospital_pharmacy_configuration"/>
        <field name="action" eval="'ir.actions.act_window,%d' % ref('action_hospital_pharmacy_medicine')"/>
        <field name="sequence">10</field>
        <field name="web_icon" eval="False"/>
    </record>
</odoo>
